---
// Reliable single-page quote form. It intentionally has no JavaScript dependency,
// so it remains usable on direct visits, cached pages, mobile browsers, and Astro transitions.
import { BUSINESS } from '../config';

interface Props {
  variant?: 'cleaning' | 'snow';
}

const { variant = 'cleaning' } = Astro.props;
const snow = variant === 'snow';
const prefix = snow ? 'snow-quote' : 'cleaning-quote';

const subject = snow
  ? '🔔 NEW SNOW QUOTE REQUEST — jsmcommercialservice.com'
  : '🔔 NEW FACILITY WALKTHROUGH REQUEST — jsmcommercialservice.com';

const facilities = snow
  ? ['Office', 'Retail', 'Medical', 'Industrial / Warehouse', 'HOA / Multifamily', 'Other']
  : [
      'Office',
      'Commercial real estate / Multi-tenant',
      'Medical / Dental / Clinic',
      'Retail / Shopping center',
      'Fitness center / Gym',
      'School / Campus',
      'Stadium / Event venue',
      'Industrial / Warehouse',
      'Vacant commercial suite / Turnover',
      'Multifamily',
      'Other',
    ];

const needs = snow
  ? ['Seasonal contract', 'Per-event service', 'Not sure yet']
  : [
      'Recurring janitorial',
      'Nightly cleaning',
      'Replace current provider',
      'Move-out / Tenant turnover',
      'One-time project',
      'Not sure yet',
    ];

const sizes = snow
  ? ['Under 20 spaces', '20–50 spaces', '50–150 spaces', '150+ spaces', 'Not sure']
  : ['Under 5,000 sq ft', '5,000–20,000 sq ft', '20,000–50,000 sq ft', '50,000+ sq ft', 'Not sure'];

const serviceOptions = snow
  ? ['Parking lot plowing', 'Sidewalks & entrances', 'Salting / de-icing', 'Anti-icing pre-treatment', 'Snow hauling / stacking']
  : [
      'Janitorial / Commercial cleaning',
      'Office / Nightly cleaning',
      'Gym / Fitness center',
      'Multi-tenant / Common areas',
      'Clinic / Medical office',
      'Retail / Shopping center',
      'School / Campus',
      'Warehouse / Industrial',
      'Stadium / Event venue',
      'Move-out / Tenant turnover',
      'Day porter',
      'Floor care',
      'Carpet cleaning',
      'Window cleaning',
      'Disinfection',
      'Post-construction',
      'Snow removal',
    ];

const submitText = snow ? 'Request Snow Pricing' : 'Request My Free Walkthrough';
---

<form action={BUSINESS.formspreeEndpoint} method="POST" class="quote-form">
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_next" value="https://jsmcommercialservice.com/thank-you/" />
  <input type="hidden" name="form_type" value={snow ? 'snow-removal' : 'cleaning'} />
  <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form-section">
    <div class="section-number" aria-hidden="true">1</div>
    <div class="section-content">
      <h3>{snow ? 'Tell us about the property' : 'Tell us about the facility'}</h3>
      <div class="field-grid">
        <label>
          <span>{snow ? 'Property type' : 'Commercial facility type'} *</span>
          <select name="facility_type" required>
            <option value="">Select one</option>
            {facilities.map((facility) => <option value={facility}>{facility}</option>)}
          </select>
        </label>

        <label>
          <span>{snow ? 'Agreement type' : 'What do you need?'} *</span>
          <select name="frequency" required>
            <option value="">Select one</option>
            {needs.map((need) => <option value={need}>{need}</option>)}
          </select>
        </label>

        <label>
          <span>{snow ? 'Parking lot size' : 'Facility size'}</span>
          <select name="square_footage">
            <option value="">Select one</option>
            {sizes.map((size) => <option value={size}>{size}</option>)}
          </select>
        </label>

        <label>
          <span>City or ZIP *</span>
          <input name="city_zip" type="text" required autocomplete="postal-code" placeholder="Apple Valley, MN or 55124" />
        </label>

        {!snow && (
          <label>
            <span>Number of locations</span>
            <select name="number_of_locations">
              <option value="">Select one</option>
              <option>1 location</option>
              <option>2–5 locations</option>
              <option>6–10 locations</option>
              <option>11+ locations</option>
            </select>
          </label>
        )}
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="section-number" aria-hidden="true">2</div>
    <div class="section-content">
      <fieldset>
        <legend>{snow ? 'What needs coverage?' : 'Which services are you considering?'}</legend>
        <p class="field-help">Select all that apply.</p>
        <div class="check-grid">
          {serviceOptions.map((service, index) => (
            <label class="check-option" for={`${prefix}-service-${index}`}>
              <input id={`${prefix}-service-${index}`} type="checkbox" name="services_needed" value={service} />
              <span>{service}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="full-field">
        <span>{snow ? 'Property details or service priorities' : 'What would you most like to improve?'}</span>
        <textarea
          name="current_challenge"
          rows="4"
          placeholder={snow
            ? 'Entrances, sidewalks, lot size, trigger depth, problem areas...'
            : 'Examples: inconsistent quality, restroom complaints, missed tasks, floor care, slow response...'}
        ></textarea>
      </label>
    </div>
  </div>

  <div class="form-section">
    <div class="section-number" aria-hidden="true">3</div>
    <div class="section-content">
      <h3>Where should JSM follow up?</h3>
      <div class="field-grid">
        <label>
          <span>Name *</span>
          <input name="name" type="text" required autocomplete="name" />
        </label>

        <label>
          <span>Company</span>
          <input name="company" type="text" autocomplete="organization" />
        </label>

        <label>
          <span>Phone *</span>
          <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" />
        </label>

        <label>
          <span>Work email</span>
          <input name="email" type="email" autocomplete="email" inputmode="email" />
        </label>

        <label>
          <span>Best time to contact you</span>
          <select name="best_contact_time">
            <option value="">Any time</option>
            <option>Morning</option>
            <option>Afternoon</option>
            <option>After 4 PM</option>
          </select>
        </label>
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-primary submit-button">{submitText}</button>
  <p class="reassure">No obligation. {BUSINESS.responsePromise}</p>
</form>

<style>
  .quote-form { display: grid; gap: 1.2rem; }
  .honeypot { display: none !important; }
  .form-section { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: .85rem; padding-bottom: 1.15rem; border-bottom: 1px solid var(--border); }
  .section-number { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 800; font-size: .9rem; }
  .section-content { min-width: 0; }
  .section-content h3, legend { margin: .2rem 0 .8rem; color: var(--navy); font-size: 1rem; font-weight: 800; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; }
  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  label { display: grid; gap: .35rem; color: var(--navy); font-weight: 700; font-size: .86rem; }
  input, select, textarea { width: 100%; min-width: 0; padding: .72rem .78rem; border: 1.5px solid var(--border); border-radius: 9px; background: #fff; color: var(--text); font: inherit; }
  input:focus, select:focus, textarea:focus { outline: 2px solid rgba(25,163,154,.2); border-color: var(--teal); }
  textarea { resize: vertical; }
  .field-help { margin: -.45rem 0 .7rem; color: var(--text-soft); font-size: .8rem; }
  .check-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem; }
  .check-option { display: flex; align-items: flex-start; gap: .55rem; padding: .62rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-alt); cursor: pointer; font-weight: 600; line-height: 1.35; }
  .check-option:hover { border-color: var(--teal); background: #fff; }
  .check-option input { width: 17px; height: 17px; margin: .08rem 0 0; flex: 0 0 auto; accent-color: var(--teal-dark); }
  .full-field { margin-top: .9rem; }
  .submit-button { width: 100%; min-height: 50px; font-size: 1rem; }
  .reassure { margin: -.55rem 0 0; text-align: center; color: var(--text-soft); font-size: .82rem; }
  @media (max-width: 640px) {
    .form-section { grid-template-columns: 32px minmax(0, 1fr); gap: .65rem; }
    .section-number { width: 28px; height: 28px; font-size: .8rem; }
    .field-grid, .check-grid { grid-template-columns: 1fr; }
  }
</style>
