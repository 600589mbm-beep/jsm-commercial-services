---
// Three-step quote wizard. The default flow captures commercial cleaning needs;
// variant="snow" swaps in snow-removal questions. Contact information stays last.
import { BUSINESS } from '../config';

interface Props {
  variant?: 'cleaning' | 'snow';
}

const { variant = 'cleaning' } = Astro.props;
const snow = variant === 'snow';

const subject = snow
  ? '🔔 NEW SNOW QUOTE REQUEST — jsmcommercialservice.com'
  : '🔔 NEW FACILITY WALKTHROUGH REQUEST — jsmcommercialservice.com';

const facilityLegend = snow ? 'What kind of property?' : 'What kind of commercial facility?';
const facilities = snow
  ? ['Office', 'Retail', 'Medical', 'Industrial / Warehouse', 'HOA / Multifamily', 'Other']
  : [
      'Office',
      'Commercial real estate / Multi-tenant',
      'Medical / Dental / Clinic',
      'Retail / Shopping center',
      'Fitness center / Gym',
      'School / Campus',
      'Stadium / Event venue',
      'Industrial / Warehouse',
      'Vacant commercial suite / Turnover',
      'Multifamily',
      'Other',
    ];

const frequencyLegend = snow ? 'What kind of agreement?' : 'What do you need?';
const frequencies = snow
  ? ['Seasonal contract', 'Per-event service', 'Not sure yet']
  : [
      'Recurring janitorial',
      'Nightly cleaning',
      'Replace current provider',
      'Move-out / Tenant turnover',
      'One-time project',
      'Not sure yet',
    ];

const sizeLegend = snow ? 'Parking lot size' : 'Facility size';
const sizes = snow
  ? ['Under 20 spaces', '20–50 spaces', '50–150 spaces', '150+ spaces', 'Not sure']
  : ['Under 5,000 sq ft', '5,000–20,000 sq ft', '20,000–50,000 sq ft', '50,000+ sq ft', 'Not sure'];

const servicesLegend = snow ? 'What needs covering?' : 'Services needed';
const submitText = snow ? 'Get My Snow Quote' : 'Request My Walkthrough';

const serviceOptions = snow
  ? ['Parking lot plowing', 'Sidewalks & entrances', 'Salting / de-icing', 'Anti-icing pre-treatment', 'Snow hauling / stacking']
  : [
      'Janitorial / Commercial cleaning',
      'Office / Nightly cleaning',
      'Gym / Fitness center',
      'Multi-tenant / Common areas',
      'Clinic / Medical office',
      'Retail / Shopping center',
      'School / Campus',
      'Warehouse / Industrial',
      'Stadium / Event venue',
      'Move-out / Tenant turnover',
      'Day porter',
      'Floor care',
      'Carpet cleaning',
      'Window cleaning',
      'Disinfection',
      'Post-construction',
      'Snow removal',
    ];
---

<form action={BUSINESS.formspreeEndpoint} method="POST" class="quote-wizard" novalidate>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_next" value="https://jsmcommercialservice.com/thank-you/" />
  <input type="hidden" name="form_type" value={snow ? 'snow-removal' : 'cleaning'} />
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="progress" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><div class="progress-fill" style="width: 33%"></div></div>
  <p class="step-label">Step <span class="step-num">1</span> of 3</p>

  <fieldset class="step" data-step="1">
    <legend>{facilityLegend}</legend>
    <div class="chips">
      {facilities.map((type) => (
        <label class="chip"><input type="radio" name="facility_type" value={type} /><span>{type}</span></label>
      ))}
    </div>
    <legend>{frequencyLegend}</legend>
    <div class="chips">
      {frequencies.map((frequency) => (
        <label class="chip"><input type="radio" name="frequency" value={frequency} /><span>{frequency}</span></label>
      ))}
    </div>
    <p class="err" hidden>Please pick one option from each question.</p>
    <button type="button" class="btn btn-primary next">Next →</button>
  </fieldset>

  <fieldset class="step" data-step="2" hidden>
    <legend>{sizeLegend}</legend>
    <div class="chips">
      {sizes.map((size) => (
        <label class="chip"><input type="radio" name="square_footage" value={size} /><span>{size}</span></label>
      ))}
    </div>
    <legend>{servicesLegend}</legend>
    <div class="chips">
      {serviceOptions.map((service) => (
        <label class="chip"><input type="checkbox" name="services_needed" value={service} /><span>{service}</span></label>
      ))}
    </div>
    {!snow && (
      <div class="optional-fields">
        <label for="qw-locations">Number of locations</label>
        <select id="qw-locations" name="number_of_locations">
          <option value="">Select</option>
          <option>1 location</option>
          <option>2–5 locations</option>
          <option>6–10 locations</option>
          <option>11+ locations</option>
        </select>
        <label for="qw-challenge">What would you most like to improve?</label>
        <textarea id="qw-challenge" name="current_challenge" rows="3" placeholder="Examples: inconsistent quality, restroom complaints, floor care, missed tasks, slow response..."></textarea>
      </div>
    )}
    <label for="qw-city">City or ZIP</label>
    <input id="qw-city" name="city_zip" type="text" autocomplete="postal-code" />
    <div class="nav"><button type="button" class="btn btn-back back">← Back</button><button type="button" class="btn btn-primary next">Next →</button></div>
  </fieldset>

  <fieldset class="step" data-step="3" hidden>
    <legend>Where should we follow up?</legend>
    <label for="qw-name">Name *</label>
    <input id="qw-name" name="name" type="text" required autocomplete="name" />
    <label for="qw-company">Company</label>
    <input id="qw-company" name="company" type="text" autocomplete="organization" />
    <label for="qw-phone">Phone *</label>
    <input id="qw-phone" name="phone" type="tel" required autocomplete="tel" />
    <label for="qw-email">Work email</label>
    <input id="qw-email" name="email" type="email" autocomplete="email" />
    <label for="qw-contact-time">Best time to contact you</label>
    <select id="qw-contact-time" name="best_contact_time">
      <option value="">Any time</option>
      <option>Morning</option>
      <option>Afternoon</option>
      <option>After 4 PM</option>
    </select>
    <p class="err" hidden>Please add your name and a phone number.</p>
    <div class="nav"><button type="button" class="btn btn-back back">← Back</button><button type="submit" class="btn btn-primary">{submitText}</button></div>
    <p class="reassure">No obligation. {BUSINESS.responsePromise}</p>
  </fieldset>
</form>

<style>
  .progress { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--teal); transition: width .25s; }
  .step-label { font-size: .8rem; color: var(--text-soft); margin: .4rem 0 .8rem; }
  fieldset { border: none; padding: 0; margin: 0; }
  legend { font-weight: 700; color: var(--navy); padding: 0; margin: .8rem 0 .5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .5rem; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-block; padding: .5rem .9rem; border: 1.5px solid var(--border); border-radius: 999px; cursor: pointer; font-size: .92rem; user-select: none; transition: border-color .1s, background .1s, transform .1s; }
  .chip input:checked + span { background: var(--teal); border-color: var(--teal); color: #fff; font-weight: 600; animation: chip-pop .25s var(--ease-out); }
  .chip input:focus-visible + span { outline: 2px solid var(--blue); outline-offset: 2px; }
  .chip span:hover { border-color: var(--teal); transform: translateY(-1px); }
  @keyframes chip-pop { 50% { transform: scale(1.08); } }
  .step:not([hidden]) { animation: step-in .4s var(--ease-out); }
  .optional-fields { display: contents; }
  textarea { resize: vertical; }
  .nav { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .btn-back { background: none; border: 1.5px solid var(--border); color: var(--text-soft); }
  .err { color: #b3261e; font-size: .88rem; margin: .5rem 0 0; }
  .reassure { font-size: .82rem; color: var(--text-soft); margin-top: .9rem; margin-bottom: 0; }
  button.next, fieldset button[type='submit'] { margin-top: 1rem; }
</style>

<script>
  function setStep(form: HTMLFormElement, n: number) {
    form.querySelectorAll<HTMLFieldSetElement>('.step').forEach((fieldset) => {
      fieldset.hidden = Number(fieldset.dataset.step) !== n;
    });
    const fill = form.querySelector<HTMLElement>('.progress-fill');
    if (fill) fill.style.width = `${(n / 3) * 100}%`;
    const bar = form.querySelector('.progress');
    if (bar) bar.setAttribute('aria-valuenow', String(n));
    const num = form.querySelector('.step-num');
    if (num) num.textContent = String(n);
  }

  function validStep(form: HTMLFormElement, n: number): boolean {
    if (n === 1) {
      return !!form.querySelector('input[name="facility_type"]:checked') && !!form.querySelector('input[name="frequency"]:checked');
    }
    if (n === 3) {
      const name = form.querySelector<HTMLInputElement>('input[name="name"]');
      const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
      return !!name?.value.trim() && !!phone?.value.trim();
    }
    return true;
  }

  function initWizards() {
    document.querySelectorAll<HTMLFormElement>('.quote-wizard').forEach((form) => {
      if (form.dataset.wizardInit) return;
      form.dataset.wizardInit = '1';
      let step = 1;
      form.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const fieldset = target.closest<HTMLFieldSetElement>('.step');
        const error = fieldset?.querySelector<HTMLElement>('.err');
        if (target.classList.contains('next')) {
          if (!validStep(form, step)) {
            if (error) error.hidden = false;
            return;
          }
          if (error) error.hidden = true;
          step = Math.min(step + 1, 3);
          setStep(form, step);
        } else if (target.classList.contains('back')) {
          step = Math.max(step - 1, 1);
          setStep(form, step);
        }
      });
      form.addEventListener('submit', (event) => {
        const fieldset = form.querySelector<HTMLFieldSetElement>('.step[data-step="3"]');
        const error = fieldset?.querySelector<HTMLElement>('.err');
        if (!validStep(form, 3)) {
          event.preventDefault();
          if (error) error.hidden = false;
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initWizards);
</script>
