---
import { BUSINESS, url } from '../config';

interface Props {
  placement?: 'header' | 'footer';
}

const { placement = 'header' } = Astro.props;
---

<span class:list={['brand-logo', placement]}>
  <img
    src={url(BUSINESS.logo.src)}
    alt={BUSINESS.name}
    width={BUSINESS.logo.width}
    height={BUSINESS.logo.height}
    loading={placement === 'footer' ? 'lazy' : 'eager'}
    decoding="async"
  />
</span>

<style>
  .brand-logo {
    position: relative;
    display: block;
    width: 176px;
    max-width: 100%;
    aspect-ratio: 2.25;
    overflow: hidden;
    border-radius: .45rem;
    background: #fff;
    flex-shrink: 0;
  }

  /* Frame the uploaded artwork's white margins without changing its pixels. */
  .brand-logo img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 142%;
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
  }

  .brand-logo.footer { width: 220px; }

  @media (max-width: 1180px) {
    .brand-logo.header { width: 156px; }
  }

  @media (max-width: 600px) {
    .brand-logo.header { width: 140px; }
  }
</style>
