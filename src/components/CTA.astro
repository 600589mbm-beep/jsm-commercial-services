---
import { BUSINESS, url } from '../config';

interface Props {
  heading?: string;
}

const { heading = 'Ready for a cleaner facility?' } = Astro.props;
---

<section class="cta">
  <span class="cta-spark" style="top: 22%; left: 12%; --tw: 3.4s" aria-hidden="true">✦</span>
  <span class="cta-spark" style="top: 30%; right: 14%; --tw: 4.4s" aria-hidden="true">✦</span>
  <span class="cta-spark" style="bottom: 22%; left: 28%; --tw: 5.2s" aria-hidden="true">✦</span>
  <div class="container inner">
    <h2>{heading}</h2>
    <p>Get a free, no-obligation walkthrough and quote — usually within 24 hours.</p>
    <div class="buttons">
      <a class="btn btn-primary" href={url('/quote')}>Get My Free Quote</a>
      <a class="btn btn-outline" href={BUSINESS.phoneHref}>Call Now — {BUSINESS.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--navy), #14385a, var(--navy-dark), var(--navy));
    background-size: 300% 300%;
    animation: cta-pan 14s ease infinite;
    padding: 4rem 0;
  }
  @keyframes cta-pan {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .cta-spark {
    position: absolute;
    color: var(--teal-bright);
    font-size: 1rem;
    animation: twinkle var(--tw, 4s) ease-in-out infinite;
    pointer-events: none;
  }
  .inner { text-align: center; }
  h2 { color: #fff; }
  p { color: #c4d3df; }
  .buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
</style>
