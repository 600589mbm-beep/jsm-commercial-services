---
import Base from '../layouts/Base.astro';
import { BUSINESS, url } from '../config';
interface Props { title:string; description:string; kicker:string; updated?:string; }
const { title, description, kicker, updated='September 2026' } = Astro.props;
const schema={
  '@context':'https://schema.org','@type':'Article',headline:title,description,
  author:{'@type':'Organization',name:BUSINESS.name},publisher:{'@type':'Organization',name:BUSINESS.name},
  dateModified:'2026-09-12'
};
---
<Base title={`${title} | JSM Commercial Services`} description={description}>
  <section class="snow-resource-hero"><div class="container narrow"><nav class="crumbs dark"><a href={url('/')}>Home</a> / <a href={url('/resources')}>Resources</a> / Commercial Snow</nav><p class="eyebrow">{kicker}</p><h1>{title}</h1><p class="lead">{description}</p><p class="meta">Updated {updated} · JSM Commercial Services</p></div></section>
  <section class="resource-body"><div class="container resource-layout"><article class="article"><slot /></article><aside class="snow-aside"><p class="eyebrow">COMMERCIAL SNOW PLANNING</p><h2>Need a property-specific proposal?</h2><p>Share the property, requested trigger, operating hours, priority areas and procurement requirements before routes fill.</p><a class="btn btn-primary" href={url('/services/snow-removal#snow-request')}>Request a Snow Site Walk →</a><a href={url('/services/snow-removal')}>Commercial snow removal & ice management</a><a href={url('/resources/commercial-snow-removal-contract-minnesota')}>Snow contract guide</a><a href={url('/resources/commercial-snow-removal-rfp-checklist')}>Snow RFP checklist</a><a href={url('/resources/snow-removal-trigger-depth-guide')}>Trigger-depth guide</a><a href={url('/resources/commercial-ice-management-minnesota')}>Commercial ice management</a></aside></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
<style>
.snow-resource-hero{padding:3.8rem 0;background:linear-gradient(125deg,#071a2a,#102f43 58%,#17495a);color:#fff}.narrow{max-width:900px}.crumbs.dark,.crumbs.dark a{color:#bfd0d8}.eyebrow{font-size:.66rem;font-weight:800;letter-spacing:.14em;color:#9ed8c5}.snow-resource-hero h1{color:#fff;font-size:clamp(2.4rem,5vw,4rem);letter-spacing:-.05em;line-height:1.06}.lead{color:#c5d8df;font-size:1.02rem;line-height:1.8;max-width:790px}.meta{color:#93afb9;font-size:.72rem}.resource-body{padding:4rem 0;background:#f6f9f7}.resource-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:3rem;align-items:start}.article{max-width:820px}.article :global(h2){margin-top:2.2rem;font-size:1.65rem;letter-spacing:-.03em}.article :global(h3){margin-top:1.6rem;font-size:1.1rem}.article :global(p){color:#4f6872;line-height:1.85;font-size:.92rem}.article :global(ul){padding-left:1.25rem;color:#405e68;line-height:1.8;font-size:.88rem}.article :global(li){margin:.35rem 0}.article :global(strong){color:#173f4a}.article :global(.callout){padding:1rem 1.1rem;border-left:3px solid #0b7565;background:#eef6f2;border-radius:0 .65rem .65rem 0}.snow-aside{position:sticky;top:8.5rem;padding:1.25rem;border-radius:1rem;background:#102f42;color:#fff}.snow-aside h2{color:#fff;font-size:1.25rem}.snow-aside p:not(.eyebrow){color:#c4d7dd;font-size:.8rem;line-height:1.7}.snow-aside .btn{display:block;text-align:center;margin:.9rem 0;background:#0b7868;box-shadow:none}.snow-aside>a:not(.btn){display:block;padding:.65rem 0;border-top:1px solid #ffffff16;color:#b7dfd2;font-size:.76rem;font-weight:700;text-decoration:none}@media(max-width:850px){.resource-layout{grid-template-columns:1fr}.snow-aside{position:static}.resource-body{padding:3rem 0}}
</style>
