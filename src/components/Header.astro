---
import { BUSINESS, url } from '../config';
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')}>
      <span class="logo-mark">JSM</span>
      <span class="logo-text">{BUSINESS.name}</span>
    </a>
    <nav>
      <a href={url('/services')}>Services</a>
      <a href={url('/locations')}>Locations</a>
      <a href={url('/about')}>About</a>
      <a href={url('/contact')}>Contact</a>
    </nav>
    <div class="actions">
      <a class="phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      <a class="btn btn-primary" href={url('/quote')}>Free Quote</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .logo-mark {
    background: var(--teal);
    color: #fff;
    font-weight: 800;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }
  .logo-text { color: #fff; font-weight: 700; }
  nav { display: flex; gap: 1.1rem; flex: 1; flex-wrap: wrap; }
  nav a { color: #d7e3ec; text-decoration: none; font-weight: 500; }
  nav a:hover { color: #fff; }
  .actions { display: flex; align-items: center; gap: 1rem; }
  .phone { color: #fff; font-weight: 700; text-decoration: none; }
  @media (max-width: 720px) {
    .logo-text { display: none; }
    .phone { display: none; }
  }
</style>
