---
import { BUSINESS, url } from '../config';
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')}>
      <span class="logo-mark">JSM</span>
      <span class="logo-text">{BUSINESS.name}</span>
    </a>
    <nav>
      <a href={url('/services')}>Services</a>
      <a href={url('/locations')}>Locations</a>
      <a href={url('/about')}>About</a>
      <a href={url('/contact')}>Contact</a>
    </nav>
    <div class="actions">
      <a class="phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      <a class="btn btn-primary" href={url('/quote')}>Free Quote</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(15, 42, 67, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 0.3s var(--ease-out);
  }
  :global(body.scrolled) .site-header {
    box-shadow: 0 6px 24px rgba(10, 31, 51, 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .logo-mark {
    background: linear-gradient(135deg, var(--teal), var(--blue));
    color: #fff;
    font-weight: 800;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.5px;
    transition: transform 0.3s var(--ease-out);
  }
  .logo:hover .logo-mark { transform: rotate(-5deg) scale(1.08); }
  nav a {
    position: relative;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    background: var(--teal-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  nav a:hover::after { transform: scaleX(1); }
  .logo-text { color: #fff; font-weight: 700; }
  nav { display: flex; gap: 1.1rem; flex: 1; flex-wrap: wrap; }
  nav a { color: #d7e3ec; text-decoration: none; font-weight: 500; }
  nav a:hover { color: #fff; }
  .actions { display: flex; align-items: center; gap: 1rem; }
  .phone { color: #fff; font-weight: 700; text-decoration: none; }
  @media (max-width: 720px) {
    .logo-text { display: none; }
    .phone { display: none; }
  }
</style>
