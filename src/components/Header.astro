---
import { BUSINESS, url } from '../config';
const path=Astro.url.pathname;
const navItems=[{href:'/services',label:'Services'},{href:'/industries',label:'Industries'},{href:'/facility-care-program',label:'Care Program'},{href:'/locations',label:'Service Area'},{href:'/resources',label:'Resources'},{href:'/about',label:'About'}];
const isActive=(href:string)=>path===href || path.startsWith(`${href}/`);
---
<header class="jsm-header" data-site-header>
  <div class="jsm-utility"><div class="container jsm-utility-inner"><p><strong>Twin Cities commercial cleaning</strong><span>Local service. Building-specific care.</span></p><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></div></div>
  <div class="container jsm-mainbar">
    <a class="jsm-brand" href={url('/')} aria-label={`${BUSINESS.name} home`}><span class="jsm-mark" aria-hidden="true">JSM</span><span class="jsm-brand-copy"><strong>{BUSINESS.name}</strong><small>Facility Care &amp; Janitorial</small></span></a>
    <nav class="jsm-desktop-nav" aria-label="Primary navigation">{navItems.map(item=><a href={url(item.href)} aria-current={isActive(item.href)?'page':undefined}>{item.label}</a>)}</nav>
    <a class="jsm-desktop-cta" href={url('/quote')}>Free Walkthrough <span aria-hidden="true">↗</span></a>
    <details class="jsm-mobile-menu"><summary><span>Menu</span><span class="jsm-menu-icon" aria-hidden="true">☰</span></summary><div class="jsm-menu-panel"><nav aria-label="Mobile navigation">{navItems.map(item=><a href={url(item.href)} aria-current={isActive(item.href)?'page':undefined}>{item.label}<span aria-hidden="true">→</span></a>)}<a href={url('/switching-cleaning-companies')}>Switch Cleaning Providers <span aria-hidden="true">→</span></a><a href={url('/contact')}>Contact JSM <span aria-hidden="true">→</span></a></nav><a class="jsm-menu-cta" href={url('/quote')}>Request a Free Walkthrough →</a><a class="jsm-menu-phone" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a></div></details>
  </div>
</header>
<script>
  function initNavigation(){
    document.querySelectorAll<HTMLDetailsElement>('.jsm-mobile-menu').forEach(menu=>{
      if(menu.dataset.ready) return;
      menu.dataset.ready='true';
      menu.addEventListener('keydown',event=>{if(event.key==='Escape' && menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});
      menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
    });
  }
  initNavigation();
  document.addEventListener('astro:page-load',initNavigation);
</script>
<style>
.jsm-header{position:sticky;top:0;z-index:100;background:#102b3e;color:#fff;box-shadow:0 1px 0 #ffffff12}.jsm-utility{background:#0b2031;border-bottom:1px solid #ffffff10}.jsm-utility-inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:34px}.jsm-utility p{display:flex;align-items:center;gap:1rem;margin:0;font-size:.7rem;color:#b8cbd3}.jsm-utility strong{font-size:.65rem;font-weight:700;letter-spacing:.085em;text-transform:uppercase;color:#a6dfca}.jsm-utility a{color:#fff;white-space:nowrap;flex-shrink:0;font-weight:700;font-size:.75rem;text-decoration:none}.jsm-mainbar{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:86px;position:relative}.jsm-brand{display:flex;align-items:center;gap:.7rem;flex-shrink:0;max-width:270px;color:#fff;text-decoration:none}.jsm-mark{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;border:1px solid #82b6a440;background:linear-gradient(140deg,#267968,#163e50);border-radius:11px;font-size:.98rem;font-weight:800}.jsm-brand-copy{display:grid;gap:.2rem}.jsm-brand-copy strong{font-size:.92rem;line-height:1.25;letter-spacing:-.015em}.jsm-brand-copy small{font-size:.58rem;letter-spacing:.065em;text-transform:uppercase;color:#adc4cc}.jsm-desktop-nav{display:flex;align-items:center;gap:1.1rem;min-width:0}.jsm-desktop-nav a{font-weight:600;font-size:.78rem;white-space:nowrap;text-decoration:none;color:#cbdbe2;padding:.7rem 0}.jsm-desktop-nav a:hover,.jsm-desktop-nav a[aria-current=page]{color:#aee8cc}.jsm-desktop-cta{display:flex;align-items:center;gap:.75rem;flex-shrink:0;padding:.9rem 1.1rem;border-radius:.55rem;background:#0e7669;color:#fff;text-decoration:none;font-size:.8rem;font-weight:800;white-space:nowrap}.jsm-desktop-cta:hover,.jsm-menu-cta:hover{background:#0b6359}.jsm-mobile-menu{display:none}.jsm-header a:focus-visible,.jsm-mobile-menu summary:focus-visible{outline:3px solid #b7e5ce;outline-offset:4px}.jsm-menu-phone{color:#fff}
@media(max-width:1100px){.jsm-desktop-nav,.jsm-desktop-cta{display:none}.jsm-mobile-menu{display:block;flex-shrink:0}.jsm-mainbar{min-height:76px;gap:1rem}.jsm-mobile-menu summary{display:flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;padding:.6rem .75rem;border:1px solid #7896a666;border-radius:.6rem;cursor:pointer;list-style:none;font-weight:700;font-size:.8rem}.jsm-mobile-menu summary::-webkit-details-marker{display:none}.jsm-menu-icon{font-size:1rem;line-height:1}.jsm-mobile-menu[open] summary{background:#254757}.jsm-menu-panel{position:absolute;left:1.25rem;right:1.25rem;top:calc(100% - 3px);background:#102b3e;border:1px solid #53768580;padding:1rem;border-radius:0 0 .8rem .8rem;box-shadow:0 18px 40px #071c2e40;max-height:calc(100dvh - 130px);overflow-y:auto}.jsm-menu-panel nav{display:grid;grid-template-columns:1fr 1fr;gap:0 1.2rem}.jsm-menu-panel nav a{display:flex;justify-content:space-between;align-items:center;gap:.6rem;color:#dfebef;text-decoration:none;font-size:.88rem;min-height:47px;border-bottom:1px solid #ffffff12;font-weight:600}.jsm-menu-panel nav a[aria-current=page]{color:#aee8cc}.jsm-menu-panel nav a>span{color:#86bba8}.jsm-menu-cta{display:block;margin-top:1rem;text-align:center;border-radius:.5rem;background:#0e7669;color:#fff;padding:.85rem 1rem;text-decoration:none;font-weight:800;font-size:.86rem}.jsm-menu-phone{display:block;text-align:center;padding:.8rem;font-weight:700;font-size:.8rem;text-decoration:none}}
@media(max-width:600px){.jsm-utility span{display:none}.jsm-utility strong{font-size:.55rem;letter-spacing:.025em}.jsm-utility a{font-size:.65rem}.jsm-utility-inner{gap:.5rem;min-height:30px}.jsm-brand{max-width:235px;gap:.55rem}.jsm-brand-copy strong{font-size:.8rem;max-width:145px}.jsm-brand-copy small{display:none}.jsm-mark{width:40px;height:40px;flex-basis:40px;font-size:.85rem}.jsm-mainbar{min-height:70px}.jsm-mobile-menu summary{padding:.55rem .6rem;font-size:.74rem}.jsm-menu-panel{left:.75rem;right:.75rem}.jsm-menu-panel nav{grid-template-columns:1fr}.jsm-menu-panel nav a{font-size:.85rem}}
</style>
