---
import { BUSINESS, url } from '../config';
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')} aria-label={`${BUSINESS.name} home`}>
      <span class="logo-mark">JSM</span>
      <span class="logo-text">{BUSINESS.name}</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={url('/services')}>Services</a>
      <a href={url('/industries')}>Industries</a>
      <a href={url('/facility-care-program')}>Facility Program</a>
      <a href={url('/locations')}>Locations</a>
      <a href={url('/resources')}>Resources</a>
      <a href={url('/about')}>About</a>
      <a href={url('/contact')}>Contact</a>
    </nav>
    <div class="actions">
      <a class="phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      <a class="btn btn-primary" href={url('/quote')}>Free Walkthrough</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(15, 42, 67, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 0.3s var(--ease-out);
  }
  :global(body.scrolled) .site-header { box-shadow: 0 6px 24px rgba(10, 31, 51, 0.45); }
  .bar { display: flex; align-items: center; gap: 1.25rem; padding-top: .7rem; padding-bottom: .7rem; }
  .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; flex-shrink: 0; }
  .logo-mark { background: linear-gradient(135deg, var(--teal), var(--blue)); color: #fff; font-weight: 800; padding: .3rem .55rem; border-radius: 6px; letter-spacing: .5px; transition: transform .3s var(--ease-out); }
  .logo:hover .logo-mark { transform: rotate(-5deg) scale(1.08); }
  .logo-text { color: #fff; font-weight: 700; white-space: nowrap; }
  nav { display: flex; gap: .9rem; flex: 1; align-items: center; }
  nav a { position: relative; color: #d7e3ec; text-decoration: none; font-weight: 600; font-size: .88rem; white-space: nowrap; }
  nav a::after { content: ''; position: absolute; left: 0; bottom: -5px; width: 100%; height: 2px; background: var(--teal-bright); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease-out); }
  nav a:hover { color: #fff; }
  nav a:hover::after { transform: scaleX(1); }
  .actions { display: flex; align-items: center; gap: .8rem; flex-shrink: 0; }
  .phone { color: #fff; font-weight: 700; text-decoration: none; font-size: .88rem; }
  .actions .btn { padding: .68rem 1rem; font-size: .88rem; }
  @media (max-width: 1080px) {
    nav { overflow-x: auto; padding: .35rem 0; order: 3; flex-basis: 100%; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    .bar { flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .logo-text, .phone { display: none; }
    .bar { justify-content: space-between; }
    nav { gap: 1rem; }
  }
</style>
