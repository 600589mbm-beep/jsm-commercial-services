---
import { BUSINESS, url } from '../config';
import { SERVICES } from '../data/services';
import { LOCATIONS } from '../data/locations';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <h3>{BUSINESS.name}</h3>
      <p>Commercial cleaning and janitorial services with enterprise-level standards and owner-led local accountability across the Twin Cities.</p>
      <p>
        <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a><br />
        <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a><br />
        <a href={`mailto:${BUSINESS.infoEmail}`}>{BUSINESS.infoEmail}</a><br />
        {BUSINESS.address.street}<br />
        {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}<br />
        {BUSINESS.hours}
      </p>
    </div>
    <div>
      <h3>Commercial Cleaning Services</h3>
      <ul>
        {SERVICES.map((service) => (
          <li><a href={url(`/services/${service.slug}`)}>{service.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Contracts &amp; Facility Resources</h3>
      <ul>
        <li><a href={url('/janitorial-contracts')}>Commercial Janitorial Contracts</a></li>
        <li><a href={url('/facility-care-program')}>JSM Facility Care Program</a></li>
        <li><a href={url('/switching-cleaning-companies')}>Switch Cleaning Providers</a></li>
        <li><a href={url('/resources/templates')}>Janitorial RFP &amp; Vendor Scorecard</a></li>
        <li><a href={url('/resources/cleaning-cost-calculator')}>Cleaning Cost Calculator</a></li>
        <li><a href={url('/resources')}>All Resources &amp; Guides</a></li>
      </ul>
    </div>
    <div>
      <h3>Company &amp; Facility Types</h3>
      <ul>
        <li><a href={url('/locations/apple-valley')}>Commercial Cleaning in Apple Valley</a></li>
        <li><a href={url('/locations')}>Twin Cities Service Area</a></li>
        <li><a href={url('/industries')}>Industries We Serve</a></li>
        <li><a href={url('/industries/stadium-event-venue-cleaning')}>Stadium &amp; Event Venue Cleaning</a></li>
        <li><a href={url('/about')}>About JSM</a></li>
        <li><a href={url('/contact')}>Contact JSM</a></li>
        <li><a href={url('/quote')}>Request a Free Walkthrough</a></li>
      </ul>
    </div>
  </div>
  <div class="container cities">
    <h3>Commercial Cleaning Across {LOCATIONS.length} Twin Cities Communities</h3>
    <p class="city-links">
      {LOCATIONS.map((location) => (
        <a href={url(`/locations/${location.slug}`)}>{location.name}, MN</a>
      ))}
    </p>
  </div>
  <div class="container legal">
    <p>© {year} {BUSINESS.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-dark); color: #c4d3df; margin-top: 3rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 2rem; padding-top: 3rem; padding-bottom: 2rem; }
  h3 { color: #fff; font-size: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .4rem; }
  a { color: #c4d3df; text-decoration: none; }
  a:hover { color: #fff; }
  .cities { border-top: 1px solid rgba(255,255,255,.12); padding-top: 1.5rem; padding-bottom: 1.5rem; }
  .cities h3 { font-size: .95rem; margin-bottom: .8rem; }
  .city-links { display: flex; flex-wrap: wrap; gap: .35rem 1.1rem; font-size: .85rem; margin: 0; }
  .legal { border-top: 1px solid rgba(255,255,255,.12); padding-top: 1rem; padding-bottom: 1.5rem; font-size: .85rem; }
</style>
