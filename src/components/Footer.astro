---
import { BUSINESS, url } from '../config';
import { SERVICES } from '../data/services';
import { LOCATIONS } from '../data/locations';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <h3>{BUSINESS.name}</h3>
      <p>{BUSINESS.tagline}</p>
      <p>
        <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a><br />
        <a href="mailto:sales@jsmcommercialservices.com">sales@jsmcommercialservices.com</a><br />
        <a href="mailto:info@jsmcommercialservices.com">info@jsmcommercialservices.com</a><br />
        {BUSINESS.address.street}<br />
        {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}<br />
        {BUSINESS.hours}
      </p>
    </div>
    <div>
      <h3>Services</h3>
      <ul>
        {SERVICES.map((s) => (
          <li><a href={url(`/services/${s.slug}`)}>{s.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Company</h3>
      <ul>
        <li><a href={url('/about')}>About Us</a></li>
        <li><a href={url('/services')}>All Services</a></li>
        <li><a href={url('/locations')}>Service Area</a></li>
        <li><a href={url('/resources')}>Resources & Guides</a></li>
        <li><a href={url('/contact')}>Contact</a></li>
        <li><a href={url('/quote')}>Get a Free Quote</a></li>
      </ul>
    </div>
  </div>
  <div class="container cities">
    <h3>Serving {LOCATIONS.length} Cities Across the {BUSINESS.serviceArea}</h3>
    <p class="city-links">
      {LOCATIONS.map((l) => (
        <a href={url(`/locations/${l.slug}`)}>{l.name}</a>
      ))}
    </p>
  </div>
  <div class="container legal">
    <p>© {year} {BUSINESS.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-dark); color: #c4d3df; margin-top: 3rem; }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  h3 { color: #fff; font-size: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: 0.4rem; }
  a { color: #c4d3df; text-decoration: none; }
  a:hover { color: #fff; }
  .cities {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .cities h3 { font-size: 0.95rem; margin-bottom: 0.8rem; }
  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-size: 0.85rem;
    margin: 0;
  }
  .legal { border-top: 1px solid rgba(255, 255, 255, 0.12); padding-top: 1rem; padding-bottom: 1.5rem; font-size: 0.85rem; }
</style>
