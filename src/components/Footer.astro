---
import { BUSINESS, url } from '../config';
import { SERVICES } from '../data/services';
import { LOCATIONS } from '../data/locations';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <h3>{BUSINESS.name}</h3>
      <p>{BUSINESS.tagline}</p>
      <p>
        <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a><br />
        <a href="mailto:sales@jsmcommercialservices.com">sales@jsmcommercialservices.com</a><br />
        <a href="mailto:info@jsmcommercialservices.com">info@jsmcommercialservices.com</a><br />
        {BUSINESS.address.street}<br />
        {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}<br />
        {BUSINESS.hours}
      </p>
    </div>
    <div>
      <h3>Services</h3>
      <ul>
        {SERVICES.map((s) => (
          <li><a href={url(`/services/${s.slug}`)}>{s.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Service Area</h3>
      <ul>
        {LOCATIONS.slice(0, 12).map((l) => (
          <li><a href={url(`/locations/${l.slug}`)}>{l.name}, MN</a></li>
        ))}
        <li><a href={url('/locations')}><strong>All {LOCATIONS.length} cities →</strong></a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>© {year} {BUSINESS.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-dark); color: #c4d3df; margin-top: 3rem; }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  h3 { color: #fff; font-size: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: 0.4rem; }
  a { color: #c4d3df; text-decoration: none; }
  a:hover { color: #fff; }
  .legal { border-top: 1px solid rgba(255, 255, 255, 0.12); padding-top: 1rem; padding-bottom: 1.5rem; font-size: 0.85rem; }
</style>
