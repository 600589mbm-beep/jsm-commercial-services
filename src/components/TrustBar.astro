---
// True-claims-only trust bar. The star-rating widget belongs here too, but
// ONLY once real Google reviews exist — set showStats + stats in config.ts.
import { BUSINESS } from '../config';
---

<div class="trust-bar">
  {BUSINESS.showStats && BUSINESS.stats.rating && (
    <span class="stars" aria-label={`Rated ${BUSINESS.stats.rating} out of 5`}>
      ★★★★★ <strong>{BUSINESS.stats.rating}</strong> from {BUSINESS.stats.reviewCount} Google reviews
    </span>
  )}
  <span>✓ Bonded &amp; Insured</span>
  <span>✓ Background-Checked Staff</span>
  <span>✓ Free Re-Clean Guarantee</span>
</div>

<style>
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.92rem;
    color: #c4d3df;
  }
  .stars { color: #ffc857; font-weight: 600; }
  .stars strong { color: #fff; }
</style>
