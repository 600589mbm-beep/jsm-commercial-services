---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { BUSINESS, url } from '../../config';
import { ARTICLES } from '../../data/articles';
import { COST_GUIDES, PILLAR_SLUG } from '../../data/costGuides';

const pillar = COST_GUIDES.find((guide) => guide.slug === PILLAR_SLUG)!;
const clusters = COST_GUIDES.filter((guide) => guide.slug !== PILLAR_SLUG);
const snowGuides = [
  {slug:'commercial-snow-removal-minnesota',title:'Minnesota Commercial Snow Removal Planning Guide',description:'Plan a commercial property before winter: site walks, triggers, lots, sidewalks, de-icing, storage, contracts and bid comparison.'},
  {slug:'commercial-snow-removal-contract-minnesota',title:'Commercial Snow Removal Contracts in Minnesota',description:'Compare seasonal and per-event structures, trigger terms, hauling, scope and proposal assumptions.'},
  {slug:'commercial-snow-removal-rfp-checklist',title:'Commercial Snow Removal RFP Checklist',description:'Give every bidder the same property, trigger, surface, ice-management, documentation and pricing requirements.'},
  {slug:'snow-removal-trigger-depth-guide',title:'Commercial Snow Trigger Depth Guide',description:'Understand one-inch, two-inch, custom triggers, event definitions and operating-priority terms.'},
  {slug:'commercial-ice-management-minnesota',title:'Commercial Ice Management in Minnesota',description:'De-icing, anti-icing, pedestrian surfaces, refreeze risks and clearer winter-scope language.'},
];
---

<Base
  title={`Commercial Facility Resources, Snow RFPs & Cost Guides | ${BUSINESS.shortName}`}
  description={`Free commercial facility resources from JSM: commercial snow contracts and RFP guides, janitorial guidance, cost guides, calculators, templates, checklists and vendor tools.`}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Home</a> / Resources</nav>
      <div class="section-head">
        <h1>Commercial Facility Resources &amp; Guides</h1>
        <p>Straight answers for property, facility and office managers—commercial snow procurement, janitorial contracts, costs, RFPs and vendor comparison. Nothing gated.</p>
      </div>

      <section class="snow-resource-band">
        <div class="snow-head">
          <div><p class="label">Commercial winter operations</p><h2>Commercial Snow Removal &amp; Ice Management Resources</h2></div>
          <a class="btn btn-primary" href={url('/services/snow-removal')}>Explore Commercial Snow Service →</a>
        </div>
        <div class="snow-grid">
          {snowGuides.map((guide,index)=><a class="snow-card" href={url(`/resources/${guide.slug}`)}><span>0{index+1}</span><h3>{guide.title}</h3><p>{guide.description}</p><i aria-hidden="true">→</i></a>)}
        </div>
      </section>

      <h2>Contracts, Tools &amp; Templates</h2>
      <div class="grid grid-3 block">
        <div class="card featured-card"><p class="label">High-intent guide</p><h3><a href={url('/janitorial-contracts')}>Commercial Janitorial Contracts</a></h3><p>Understand scope, frequencies, pricing factors, inspections, agreement terms, and how to compare recurring cleaning proposals.</p></div>
        <div class="card"><h3><a href={url('/resources/cleaning-cost-calculator')}>Cleaning Cost Calculator</a></h3><p>Estimate your monthly cleaning cost in 30 seconds from published market ranges. No email required.</p></div>
        <div class="card"><h3><a href={url('/resources/templates')}>Free RFP &amp; Vendor Templates</a></h3><p>Janitorial RFP, printable cleaning checklist, and a vendor comparison scorecard—web and PDF.</p></div>
        <div class="card"><h3><a href={url('/switching-cleaning-companies')}>Switch Cleaning Providers</a></h3><p>Use a controlled transition plan to replace an underperforming commercial cleaning vendor without creating a service gap.</p></div>
      </div>

      <h2>Commercial Cleaning Cost Guides</h2>
      <div class="grid grid-3 block">
        <div class="card"><h3><a href={url(`/resources/${pillar.slug}`)}>{pillar.title}</a></h3><p>{pillar.description}</p></div>
        {clusters.map((guide)=><div class="card"><h3><a href={url(`/resources/${guide.slug}`)}>{guide.title}</a></h3><p>{guide.description}</p></div>)}
      </div>

      <h2>Buying &amp; Vetting Guides</h2>
      <div class="grid grid-3 block">
        {ARTICLES.map((article)=><div class="card"><h3><a href={url(`/resources/${article.slug}`)}>{article.title}</a></h3><p>{article.description}</p></div>)}
      </div>
    </div>
  </section>
  <CTA heading="Need a written scope and comparable proposal?" />
</Base>

<style>
.block{margin-bottom:2.5rem}h2{margin-top:.5rem}.featured-card{border-color:rgba(25,163,154,.45);background:linear-gradient(145deg,rgba(25,163,154,.07),#fff)}.label{color:var(--teal-dark)!important;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.55rem!important}.snow-resource-band{margin:1rem 0 3rem;padding:1.5rem;border-radius:1rem;background:linear-gradient(125deg,#0b2333,#11394b);color:#fff}.snow-head{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.2rem}.snow-head h2{color:#fff;margin:.2rem 0}.snow-head .label{color:#9ed8c5!important}.snow-head .btn{background:#0b7868;box-shadow:none}.snow-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.snow-card{position:relative;display:block;padding:1rem 2rem 1rem 1rem;border:1px solid #ffffff18;border-radius:.75rem;background:#ffffff08;color:#fff;text-decoration:none}.snow-card>span{font-size:.55rem;color:#8fc8b4;font-weight:800}.snow-card h3{color:#fff;font-size:.88rem;margin:.45rem 0}.snow-card p{color:#b9cdd5;font-size:.72rem;line-height:1.55;margin:0}.snow-card i{position:absolute;right:.8rem;top:50%;transform:translateY(-50%);font-style:normal;color:#9ed8c5}.snow-card:hover{background:#ffffff10;border-color:#ffffff30}@media(max-width:850px){.snow-head{display:block}.snow-head .btn{margin-top:.8rem}.snow-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.snow-grid{grid-template-columns:1fr}.snow-resource-band{padding:1rem}}
</style>
