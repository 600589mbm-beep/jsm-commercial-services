---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { BUSINESS, url } from '../../config';
import { ARTICLES } from '../../data/articles';
import { COST_GUIDES, PILLAR_SLUG } from '../../data/costGuides';

export function getStaticPaths() {
  return [
    ...ARTICLES.map((article) => ({ params: { slug: article.slug }, props: { article, isCostGuide: false } })),
    ...COST_GUIDES.map((article) => ({ params: { slug: article.slug }, props: { article, isCostGuide: true } })),
  ];
}

const { article, isCostGuide } = Astro.props;
const related = 'related' in article ? article.related : [];
const clusterSiblings = isCostGuide
  ? COST_GUIDES.filter((g) => g.slug !== article.slug)
  : [];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  dateModified: article.updated,
  author: { '@type': 'Organization', name: BUSINESS.name },
  publisher: { '@type': 'Organization', name: BUSINESS.name },
};
---

<Base title={`${article.title} | ${BUSINESS.name}`} description={article.description}>
  <section class="section">
    <div class="container article">
      <nav class="crumbs">
        <a href={url('/')}>Home</a> / <a href={url('/resources')}>Resources</a> / Guide
      </nav>
      <h1>{article.title}</h1>
      <p class="meta">Updated {article.updated} · by {BUSINESS.name}</p>
      {article.sections.map((s) => (
        <>
          {s.h && <h2>{s.h}</h2>}
          {s.ps.map((p) => <p>{p}</p>)}
          {s.list && (
            <ul class="checklist">
              {s.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </>
      ))}
      {related.length > 0 && (
        <>
          <h2>Related</h2>
          <ul class="checklist">
            {related.map(([text, path]) => (
              <li><a href={url(path)}>{text}</a></li>
            ))}
          </ul>
        </>
      )}
      {isCostGuide && (
        <aside class="cluster card">
          <h2>The Cleaning Cost Guide Series</h2>
          <ul>
            {clusterSiblings.map((g) => (
              <li>
                <a href={url(`/resources/${g.slug}`)}>
                  {g.slug === PILLAR_SLUG ? `→ ${g.label}` : g.label}
                </a>
              </li>
            ))}
            <li><a href={url('/resources/cleaning-cost-calculator')}>Free cleaning cost calculator</a></li>
          </ul>
        </aside>
      )}
      <div class="article-cta card">
        <h2>Want numbers for your facility?</h2>
        <p>
          We quote from a free walkthrough — written scope, clear price, month-to-month.
          Serving the {BUSINESS.serviceArea}.
        </p>
        <a class="btn btn-primary" href={url('/quote')}>Get My Free Quote</a>
      </div>
    </div>
  </section>
  <CTA />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Base>

<style>
  .article { max-width: 780px; }
  .article h2 { margin-top: 2rem; }
  .meta { color: var(--text-soft); font-size: 0.9rem; margin-bottom: 2rem; }
  .article-cta { margin-top: 3rem; text-align: center; }
  .article-cta .btn { margin-top: 0.5rem; }
  .cluster { margin-top: 2.5rem; }
  .cluster h2 { margin-top: 0; font-size: 1.1rem; }
  .cluster ul { list-style: none; padding: 0; margin: 0; }
  .cluster li { margin-bottom: 0.45rem; }
  .cluster a { font-weight: 600; text-decoration: none; }
  .cluster a:hover { text-decoration: underline; }
</style>
