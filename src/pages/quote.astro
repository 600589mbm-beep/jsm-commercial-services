---
import Base from '../layouts/Base.astro';
import WalkthroughForm from '../components/WalkthroughForm.astro';
import QuickInquiryForm from '../components/QuickInquiryForm.astro';
import { BUSINESS, url } from '../config';

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: BUSINESS.website + '/' },
    { '@type': 'ListItem', position: 2, name: 'Request a cleaning walkthrough', item: BUSINESS.website + '/quote/' },
  ],
};
---

<Base
  title="Schedule a Cleaning Walkthrough | Twin Cities | JSM"
  description="Request a free Twin Cities cleaning walkthrough. Choose a preferred date, describe your building, set 1–7 cleaning days per week and share your RFP."
>
  <section class="request-hero">
    <div class="request-grid-art" aria-hidden="true"></div>
    <div class="request-glow" aria-hidden="true"></div>
    <div class="container hero-layout">
      <div class="hero-copy">
        <nav class="request-crumb" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span>/</span>Free walkthrough</nav>
        <p class="eyebrow">FOR PROPERTY MANAGERS & BUSINESS OWNERS</p>
        <h1>A better cleaning plan<br />starts with your building.</h1>
        <p>Request a free, no-obligation commercial cleaning walkthrough for your Twin Cities facility. JSM Commercial Services will review your building, cleaning priorities and preferred schedule, then prepare a written proposal based on the agreed scope.</p>
        <p>Suitable for offices, clinics, retail stores, warehouses and managed properties.</p>
        <p><strong>Submit your request September 30–October 31, 2026.</strong> No purchase required. Visit date and service availability are confirmed by JSM.</p>
        <div class="hero-actions">
          <a class="jump" href="#quick-inquiry">Request a quick callback <span aria-hidden="true">↓</span></a>
          <a class="detailed-link" href="#walkthrough-form">Plan a detailed walkthrough →</a>
          <span class="hero-note"><i aria-hidden="true">✓</i>No obligation</span>
        </div>
      </div>

      <aside class="hero-preview" aria-label="Preview of the walkthrough request process">
        <div class="preview-head"><span class="preview-mark">JSM</span><div><small>WALKTHROUGH REQUEST</small><strong>Four clear steps</strong></div><i aria-hidden="true"></i></div>
        <div class="preview-body">
          <div class="preview-row active"><span>01</span><p><small>Building</small><strong>Type, address & spaces</strong></p><i aria-hidden="true">⌂</i></div>
          <div class="preview-row"><span>02</span><p><small>Cleaning</small><strong>1–7 days & timing</strong></p><i aria-hidden="true">◷</i></div>
          <div class="preview-row"><span>03</span><p><small>Visit & RFP</small><strong>Date, scope & documents</strong></p><i aria-hidden="true">▤</i></div>
          <div class="preview-row"><span>04</span><p><small>Contact</small><strong>Review & send</strong></p><i aria-hidden="true">→</i></div>
        </div>
        <div class="preview-foot"><span aria-hidden="true">●</span>Preferred dates are confirmed by JSM</div>
      </aside>
    </div>
  </section>

  <section class="request-body">
    <div class="body-glow" aria-hidden="true"></div>
    <div class="container request-layout">
      <div id="walkthrough-request" class="request-card">
        <div class="card-accent" aria-hidden="true"></div>
        <section id="quick-inquiry" aria-label="Quick callback or quote inquiry"><QuickInquiryForm /></section>
        <div class="form-divider"><span>Have the building details ready?</span><p>Use the detailed walkthrough request below to choose cleaning days, suggest a visit date and share your RFP.</p></div>
        <section id="free-commercial-cleaning-walkthrough" class="walkthrough-offer" aria-labelledby="walkthrough-offer-title">
          <p class="eyebrow">WALKTHROUGH OFFER · NO PURCHASE REQUIRED</p>
          <h2 id="walkthrough-offer-title">Free Commercial Cleaning Walkthrough</h2>
          <p class="offer-dates">Request period: <time datetime="2026-09-30">September 30</time>–<time datetime="2026-10-31">October 31, 2026</time></p>
          <img src={url('/og-default.png').replace(/\/$/, '')} width="1200" height="630" alt="JSM Commercial Services commercial cleaning and janitorial services in the Twin Cities" loading="lazy" />
          <p>Request a free, no-obligation commercial cleaning walkthrough for your Twin Cities facility. JSM Commercial Services will review your building, cleaning priorities and preferred schedule, then prepare a written proposal based on the agreed scope. Suitable for offices, clinics, retail stores, warehouses and managed properties. Submit your request September 30–October 31, 2026. No purchase required. Visit date and service availability are confirmed by JSM.</p>
          <a class="jump" href="#walkthrough-form">Redeem offer: request your free walkthrough <span aria-hidden="true">↓</span></a>
          <p class="offer-terms"><strong>Terms:</strong> Applies to requests submitted September 30–October 31, 2026 for commercial properties within JSM’s Twin Cities service area. The walkthrough and proposal are free; cleaning services are quoted separately. No purchase required. Walkthrough date and service availability are subject to confirmation by JSM.</p>
        </section>
        <div id="walkthrough-form"><WalkthroughForm /></div>
      </div>

      <aside class="request-aside">
        <div class="aside-sticky">
          <p class="eyebrow">WHAT HAPPENS NEXT</p>
          <h2>From first visit<br />to a clear scope.</h2>
          <ol>
            <li><span>1</span><div><h3>First, a response</h3><p>{BUSINESS.responsePromise} We discuss your needs and the next step.</p></div></li>
            <li><span>2</span><div><h3>Then, a confirmed walkthrough</h3><p>{BUSINESS.schedulingPromise}</p></div></li>
            <li><span>3</span><div><h3>A written proposal after scope review</h3><p>{BUSINESS.proposalPromise}</p></div></li>
          </ol>

          <div class="aside-note">
            <div class="note-icon" aria-hidden="true">▤</div>
            <div><h3>Documents ready?</h3><p>Add your RFP link or paste your requirements in step 3. Attachments can be emailed separately with the building name and address.</p><a href={`mailto:${BUSINESS.email}`}>Email your documents →</a></div>
          </div>

          <div class="aside-call">
            <span>Prefer a conversation?</span>
            <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
            <p>{BUSINESS.hours}<br />{BUSINESS.responsePromise}</p>
          </div>

          <a class="scope-guide" href={url('/commercial-cleaning-twin-cities')}>Explore building types, cleaning schedules and proposal planning <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</Base>

<style>
  #quick-inquiry, #walkthrough-form { scroll-margin-top:140px; }
  .form-divider { margin:2.4rem 0; padding:1.5rem 0; border-top:1px solid var(--brand-border); border-bottom:1px solid var(--brand-border); }
  .form-divider span { color:var(--navy); font-weight:800; }
  .form-divider p { margin:.4rem 0 0; color:var(--text-soft); font-size:.9rem; }
  .detailed-link { color:var(--brand-tint); font-weight:700; font-size:.82rem; }
  .hero-actions { flex-wrap:wrap; }
  .walkthrough-offer{scroll-margin-top:110px;padding-bottom:2rem;margin-bottom:2rem;border-bottom:1px solid var(--brand-border)}.walkthrough-offer h2{font-size:clamp(1.65rem,3vw,2.3rem);line-height:1.15;letter-spacing:-.035em;margin-bottom:.8rem}.walkthrough-offer img{display:block;width:100%;height:auto;border-radius:.75rem;margin:1.25rem 0}.walkthrough-offer>p{color:var(--text-soft);line-height:1.75}.walkthrough-offer .eyebrow{color:var(--brand)}.walkthrough-offer .offer-dates{font-weight:700;font-size:.85rem}.walkthrough-offer .offer-terms{font-size:.78rem;margin-top:1.2rem}.walkthrough-offer .jump{flex-wrap:wrap;line-height:1.5}#walkthrough-form{scroll-margin-top:110px}
  .request-hero{position:relative;overflow:hidden;padding:2rem 0 5.5rem;background:linear-gradient(120deg,var(--navy) 0%,var(--navy) 60%,var(--navy) 100%);color:#fff}.request-grid-art{position:absolute;inset:0;background-image:linear-gradient(#ffffff07 1px,transparent 1px),linear-gradient(90deg,#ffffff07 1px,transparent 1px);background-size:62px 62px;mask-image:linear-gradient(90deg,transparent 0,#000 54%,#000 100%);pointer-events:none}.request-glow{position:absolute;width:520px;height:520px;border-radius:50%;right:-8%;top:-38%;background:radial-gradient(circle,rgba(var(--brand-bright-rgb), 0.208) 0,rgba(var(--navy-rgb), 0.094) 45%,transparent 70%);pointer-events:none}.hero-layout{position:relative;display:grid;grid-template-columns:minmax(0,1.22fr) minmax(360px,.78fr);gap:4rem;align-items:center}.hero-copy{padding-top:.4rem}.request-crumb{display:flex;gap:.7rem;font-size:.74rem;color:var(--text-on-dark);margin-bottom:2.2rem}.request-crumb a{color:var(--brand-border)}.eyebrow{font-size:.68rem;letter-spacing:.145em;font-weight:800;color:var(--brand)}.request-hero .eyebrow{color:var(--brand-tint)}.request-hero h1{color:#fff;max-width:780px;font-size:clamp(2.5rem,4.7vw,4.15rem);letter-spacing:-.052em;line-height:1.05;margin-bottom:1.4rem}.request-hero .hero-copy>p:not(.eyebrow){max-width:660px;color:var(--brand-border);line-height:1.8;font-size:1.03rem}.hero-actions{display:flex;align-items:center;gap:1rem;margin-top:1.25rem}.jump{display:inline-flex;align-items:center;gap:.8rem;padding:.82rem 1rem;border-radius:.6rem;background:var(--brand);color:#fff;font-weight:800;text-decoration:none;box-shadow:0 10px 24px rgba(var(--navy-dark-rgb), 0.188)}.jump span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#ffffff18}.hero-note{display:flex;align-items:center;gap:.45rem;font-size:.75rem;color:var(--text-on-dark)}.hero-note i{display:grid;place-items:center;width:19px;height:19px;border-radius:50%;background:rgba(var(--brand-light-rgb), 0.098);color:var(--brand-tint);font-size:.6rem;font-style:normal}.hero-preview{position:relative;overflow:hidden;border:1px solid #ffffff1f;border-radius:1.15rem;background:linear-gradient(145deg,#ffffff12,#ffffff08);box-shadow:0 24px 64px rgba(var(--navy-dark-rgb), 0.259);backdrop-filter:blur(10px)}.hero-preview:before{content:'';position:absolute;right:-72px;bottom:-86px;width:200px;height:200px;border:1px solid rgba(var(--brand-light-rgb), 0.149);border-radius:50%;box-shadow:0 0 0 24px #ffffff08,0 0 0 48px rgba(var(--brand-light-rgb), 0.067)}.preview-head{display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;padding:1rem 1.15rem;border-bottom:1px solid #ffffff14}.preview-mark{display:grid;place-items:center;width:39px;height:39px;border-radius:10px;background:var(--brand-surface);color:var(--navy);font-size:.78rem;font-weight:800}.preview-head div{display:grid;gap:.14rem}.preview-head small{font-size:.5rem;letter-spacing:.13em;color:var(--brand-light);font-weight:800}.preview-head strong{font-size:.82rem;color:#fff}.preview-head i{width:9px;height:9px;border-radius:50%;background:var(--brand-bright);box-shadow:0 0 0 5px rgba(var(--brand-bright-rgb), 0.098)}.preview-body{padding:.45rem 1rem .7rem}.preview-row{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.72rem .25rem;border-bottom:1px solid #ffffff10}.preview-row:last-child{border-bottom:0}.preview-row>span{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#ffffff0e;color:var(--brand-light);font-size:.58rem;font-weight:800}.preview-row p{display:grid;gap:.08rem;margin:0}.preview-row small{font-size:.56rem;color:var(--text-on-dark)}.preview-row strong{font-size:.72rem;color:var(--bg-alt)}.preview-row>i{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#ffffff0d;color:var(--brand-tint);font-size:.7rem;font-style:normal}.preview-row.active{background:rgba(var(--brand-rgb), 0.125);border-radius:.55rem;border-bottom-color:transparent;padding-left:.45rem;padding-right:.45rem}.preview-row.active>span{background:var(--brand);color:#fff}.preview-foot{position:relative;display:flex;align-items:center;gap:.45rem;padding:.8rem 1.15rem;border-top:1px solid #ffffff12;color:var(--brand-light);font-size:.62rem}.preview-foot span{color:var(--brand-bright);font-size:.5rem}.request-body{position:relative;overflow:hidden;background:linear-gradient(180deg,var(--bg-alt) 0%,var(--brand-surface) 100%);padding:0 0 5.5rem}.body-glow{position:absolute;width:520px;height:520px;border-radius:50%;left:-16%;top:18%;background:radial-gradient(circle,rgba(var(--brand-light-rgb), 0.188) 0,transparent 68%);pointer-events:none}.request-layout{position:relative;display:grid;grid-template-columns:minmax(0,1.85fr) minmax(265px,.72fr);gap:3rem;align-items:start}.request-card{position:relative;margin-top:-2.7rem;z-index:2;background:#fff;padding:2.35rem;border-radius:1.35rem;border:1px solid var(--brand-border);box-shadow:0 28px 72px rgba(var(--navy-rgb), 0.090),0 8px 24px rgba(var(--navy-rgb), 0.039);scroll-margin-top:110px;min-width:0;overflow:hidden}.card-accent{position:absolute;left:0;right:0;top:0;height:5px;background:linear-gradient(90deg,var(--brand),var(--text-soft) 50%,var(--brand-tint))}.request-aside{padding-top:2.8rem}.aside-sticky{position:sticky;top:140px}.request-aside h2{font-size:1.85rem;line-height:1.16;letter-spacing:-.035em}.request-aside ol{position:relative;list-style:none;padding:0;margin:1.7rem 0}.request-aside ol:before{content:'';position:absolute;left:15px;top:26px;bottom:30px;width:1px;background:var(--brand-tint)}.request-aside li{position:relative;display:flex;align-items:flex-start;gap:.9rem;margin-bottom:1.55rem}.request-aside li>span{position:relative;z-index:1;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand-dark);border:1px solid var(--brand-tint);border-radius:50%;width:31px;height:31px;flex:0 0 31px;font-weight:800;font-size:.72rem;box-shadow:0 0 0 6px var(--bg-alt)}.request-aside h3{font-size:.92rem;margin:.12rem 0 .38rem}.request-aside p{color:var(--text-soft);font-size:.82rem;line-height:1.65}.aside-note{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1.15rem;border:1px solid var(--brand-tint);background:linear-gradient(145deg,var(--bg-alt),var(--brand-soft));border-radius:.8rem;box-shadow:0 10px 24px rgba(var(--navy-rgb), 0.039)}.note-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#fff;color:var(--brand);font-size:1rem;box-shadow:0 6px 14px rgba(var(--navy-rgb), 0.063)}.aside-note h3{margin:.05rem 0 .25rem}.aside-note p{margin:0 0 .45rem}.aside-note a,.scope-guide{color:var(--brand-dark);font-weight:800;font-size:.79rem}.aside-call{margin-top:1.1rem;padding:1.15rem 0;border-top:1px solid var(--brand-border);border-bottom:1px solid var(--brand-border)}.aside-call span{display:block;color:var(--text-soft);font-size:.73rem}.aside-call>a{display:block;font-size:1.6rem;font-weight:800;color:var(--navy);text-decoration:none;margin:.28rem 0}.aside-call p{margin:0}.scope-guide{display:flex;align-items:center;justify-content:space-between;gap:.7rem;line-height:1.6;padding:1rem 0}.scope-guide span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:var(--brand-soft);color:var(--brand);flex:0 0 27px}
  @media(max-width:980px){.hero-layout{grid-template-columns:1fr .8fr;gap:2rem}.request-layout{grid-template-columns:minmax(0,1.5fr) minmax(250px,.75fr);gap:2rem}.request-card{padding:1.8rem}.request-hero h1{font-size:3.2rem}}
  @media(max-width:820px){.request-hero{padding-bottom:4.4rem}.hero-layout,.request-layout{grid-template-columns:1fr}.hero-preview{max-width:560px}.request-card{margin-top:-2rem}.request-aside{padding-top:1rem}.aside-sticky{position:static}.request-aside ol{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.request-aside ol:before{display:none}.request-aside li{display:block;margin:0;padding:1rem;border:1px solid var(--brand-border);border-radius:.75rem;background:#fff}.request-aside li>span{margin-bottom:.65rem;box-shadow:none}.request-aside h2 br{display:none}.aside-note{max-width:580px}}
  @media(max-width:600px){.request-hero{padding:1.4rem 0 3.5rem}.request-grid-art{background-size:42px 42px}.request-crumb{margin-bottom:1.6rem}.request-hero h1{font-size:2.45rem}.request-hero .hero-copy>p:not(.eyebrow){font-size:.94rem}.hero-actions{align-items:flex-start;flex-direction:column}.jump{width:100%;justify-content:space-between}.hero-preview{border-radius:.9rem}.preview-head{padding:.85rem}.preview-body{padding-left:.7rem;padding-right:.7rem}.preview-row strong{font-size:.68rem}.request-body{padding-bottom:3.5rem}.request-layout{padding:0 .75rem}.request-card{padding:1.25rem;border-radius:1rem}.request-aside{padding:1rem .45rem}.request-aside ol{grid-template-columns:1fr}.request-aside li{display:flex}.request-aside li>span{margin-bottom:0}.aside-call>a{font-size:1.45rem}.body-glow{display:none}}
  @media(prefers-reduced-motion:reduce){.jump{scroll-behavior:auto}}
</style>
