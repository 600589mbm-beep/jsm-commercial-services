---
import Base from '../layouts/Base.astro';
import WalkthroughForm from '../components/WalkthroughForm.astro';
import { BUSINESS, url } from '../config';
const crumbs = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:BUSINESS.website+'/'},{'@type':'ListItem',position:2,name:'Request a cleaning walkthrough',item:BUSINESS.website+'/quote/'}]};
---
<Base title="Schedule a Cleaning Walkthrough | Twin Cities | JSM" description="Request a free Twin Cities cleaning walkthrough. Choose a preferred date, describe your building, set 1–7 cleaning days per week and share your RFP.">
  <section class="request-hero"><div class="container"><nav class="request-crumb" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span>/</span>Free walkthrough</nav><p class="eyebrow">FOR PROPERTY MANAGERS & BUSINESS OWNERS</p><h1>A better cleaning plan<br />starts with your building.</h1><p>Choose a preferred walkthrough date, tell us how often you need cleaning, and share the scope you have in mind. We will confirm the visit with you.</p><a class="jump" href="#walkthrough-request">Start your request ↓</a></div></section>
  <section class="request-body"><div class="container request-layout">
    <div id="walkthrough-request" class="request-card"><WalkthroughForm /></div>
    <aside class="request-aside"><p class="eyebrow">WHAT HAPPENS NEXT</p><h2>From first visit<br />to a clear scope.</h2><ol><li><span>1</span><div><h3>We review your request</h3><p>Your building, cleaning days, priorities and any RFP requirements.</p></div></li><li><span>2</span><div><h3>We confirm the walkthrough</h3><p>JSM contacts you to agree on the date, time and on-site contact.</p></div></li><li><span>3</span><div><h3>You receive a written proposal</h3><p>Tasks, service frequency and pricing based on the agreed scope.</p></div></li></ol>
      <div class="aside-note"><h3>Documents ready?</h3><p>Add your RFP link or paste your requirements in step 3. Attachments can be emailed separately with the building name and address.</p><a href={`mailto:${BUSINESS.email}`}>Email your documents →</a></div>
      <div class="aside-call"><span>Prefer a conversation?</span><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a><p>{BUSINESS.hours}<br />{BUSINESS.responsePromise}</p></div>
      <a class="scope-guide" href={url('/commercial-cleaning-twin-cities')}>Explore building types, cleaning schedules and proposal planning →</a>
    </aside>
  </div></section>
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</Base>
<style>
  .request-hero{padding:2rem 0 4.8rem;background:#102c40;color:#fff;position:relative;overflow:hidden}.request-hero:after{content:'';position:absolute;inset:0 0 0 58%;background:repeating-linear-gradient(90deg,transparent 0 69px,#ffffff06 70px 71px),repeating-linear-gradient(0deg,transparent 0 69px,#ffffff06 70px 71px);pointer-events:none}.request-crumb{display:flex;gap:.7rem;font-size:.78rem;color:#b6cad3;margin-bottom:2.2rem}.request-crumb a{color:#c9dce4}.eyebrow{font-size:.7rem;letter-spacing:.14em;font-weight:800;color:#0a6d63}.request-hero .eyebrow{color:#9ee0ce}.request-hero h1{color:#fff;max-width:760px;font-size:clamp(2.1rem,5vw,3.7rem);letter-spacing:-.045em;line-height:1.08}.request-hero p:not(.eyebrow){max-width:660px;color:#c8dbe2;line-height:1.8;font-size:1.03rem}.jump{display:inline-block;color:#b3edda;font-weight:700;margin-top:.5rem}.request-body{background:#f2f6f5;padding:0 0 5rem}.request-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(230px,.8fr);gap:2.8rem;align-items:start}.request-card{margin-top:-2rem;position:relative;z-index:1;background:#fff;padding:2.2rem;border-radius:1.25rem;border:1px solid #dce7e6;box-shadow:0 18px 60px #102c4010;scroll-margin-top:110px;min-width:0}.request-aside{padding-top:2.5rem}.request-aside h2{font-size:1.8rem;line-height:1.2}.request-aside ol{list-style:none;padding:0;margin:1.6rem 0}.request-aside li{display:flex;align-items:flex-start;gap:.85rem;margin-bottom:1.5rem}.request-aside li>span{display:grid;place-items:center;background:#dceee7;color:#075a50;border-radius:50%;width:30px;height:30px;flex:0 0 30px;font-weight:800;font-size:.8rem}.request-aside h3{font-size:.95rem;margin:.2rem 0 .5rem}.request-aside p{color:#536b77;font-size:.86rem;line-height:1.7}.aside-note{padding:1.3rem;border:1px solid #c9ddd5;background:#e9f2ed;border-radius:.8rem}.aside-note a,.scope-guide{color:#075e55;font-weight:700;font-size:.83rem}.aside-call{padding:1.6rem 0}.aside-call span{display:block;color:#536b77;font-size:.8rem}.aside-call>a{display:block;font-size:1.55rem;font-weight:800;color:#102c40;text-decoration:none;margin:.3rem 0}.scope-guide{display:block;line-height:1.7}
  @media(max-width:900px){.request-layout{grid-template-columns:1fr;gap:1rem}.request-aside{padding-top:1rem}.request-aside ol{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.request-aside li{display:block}.request-aside li>span{margin-bottom:.6rem}.request-aside h2 br{display:none}}
  @media(max-width:600px){.request-hero{padding-bottom:3.5rem}.request-card{padding:1.2rem;border-radius:.9rem}.request-aside ol{grid-template-columns:1fr;gap:.3rem}.request-aside li{display:flex}.request-hero h1{font-size:2.25rem}.request-layout{padding:0 .75rem}.request-aside{padding:1rem .5rem}.request-hero:after{display:none}}
</style>
