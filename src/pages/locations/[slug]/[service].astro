---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../../config';
import { LOCATIONS, CITY_LOCAL } from '../../../data/locations';
import { SERVICES, SERVICE_ICONS } from '../../../data/services';

export function getStaticPaths() {
  const paths = [];
  for (const location of LOCATIONS) {
    for (const service of SERVICES) {
      paths.push({
        params: { slug: location.slug, service: service.slug },
        props: { location, service },
      });
    }
  }
  return paths;
}

const { location, service } = Astro.props;
const local = CITY_LOCAL[location.slug];

// Google warns against indexing large sets of substantially similar city pages.
// Keep all combinations useful and crawlable for visitors, but index only the
// strongest city/service pages with real local context and core buyer demand.
const CORE_INDEXED_SERVICES = new Set([
  'janitorial-services',
  'office-cleaning',
  'day-porter-services',
  'floor-care',
  'medical-office-cleaning',
  'industrial-warehouse-cleaning',
]);
const shouldIndex = Boolean(local) && CORE_INDEXED_SERVICES.has(service.slug);

const li = LOCATIONS.findIndex((l) => l.slug === location.slug);
const si = SERVICES.findIndex((s) => s.slug === service.slug);
const v = (li + si) % 3;

const intros = [
  `${BUSINESS.name} provides ${service.name.toLowerCase()} for commercial properties in ${location.name}, MN. Every proposal starts with a free facility walkthrough, a written scope, and clear pricing. Trained, background-checked crews serve ${location.name} and the rest of ${location.county} on a schedule built around your operations. ${location.blurb}`,
  `${BUSINESS.name} delivers ${service.name.toLowerCase()} to businesses throughout ${location.name}, Minnesota, with a documented scope of work, supervisor inspections, and a free re-clean guarantee. ${location.blurb}`,
  `Businesses in ${location.name}, MN can use ${BUSINESS.name} for ${service.name.toLowerCase()} on month-to-month agreements with an assigned local team and direct accountability. We serve ${location.name} and surrounding communities throughout ${location.county}. ${location.blurb}`,
];

const nearby = LOCATIONS.filter((l) => l.county === location.county && l.slug !== location.slug).slice(0, 6);
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
const businessId = `${new URL('/', BUSINESS.website).href}#localbusiness`;
const canonical = new URL(`/locations/${location.slug}/${service.slug}/`, BUSINESS.website).href;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: `${service.name} in ${location.name}, Minnesota`,
  description: service.short,
  url: canonical,
  areaServed: { '@type': 'City', name: `${location.name}, Minnesota` },
  provider: { '@id': businessId },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url('/'), BUSINESS.website).href },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: new URL(url('/locations'), BUSINESS.website).href },
    { '@type': 'ListItem', position: 3, name: location.name, item: new URL(url(`/locations/${location.slug}`), BUSINESS.website).href },
    { '@type': 'ListItem', position: 4, name: service.name },
  ],
};
---

<Base
  title={`${service.name} in ${location.name}, MN | JSM Commercial Services`}
  description={`${service.name} for commercial facilities in ${location.name}, MN. Written scopes, background-checked crews, supervisor inspections, and free walkthroughs from JSM.`}
  robots={shouldIndex
    ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
    : 'noindex,follow'}
>
  <section class="section">
    <div class="container split">
      <div>
        <nav class="crumbs">
          <a href={url('/')}>Home</a> / <a href={url('/locations')}>Locations</a> /
          <a href={url(`/locations/${location.slug}`)}>{location.name}</a> / {service.name}
        </nav>
        <h1>{service.name} in {location.name}, MN</h1>
        <p>{intros[v]}</p>
        <p>{service.description}</p>
        {local && (
          <>
            <h2>Commercial Facilities in {location.name}</h2>
            <p>{local.context}</p>
          </>
        )}
        <h2>What’s Included</h2>
        <ul class="checklist">
          {service.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        {(service.faq.length > 0 || local) && (
          <>
            <h2>Common Questions</h2>
            {(local?.faqs ?? []).map((faq) => (
              <details class="faq-acc">
                <summary>{faq.q}<span class="plus">+</span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
            {service.faq.map((faq) => (
              <details class="faq-acc">
                <summary>{faq.q}<span class="plus">+</span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </>
        )}
        <h2>Other Commercial Cleaning Services in {location.name}</h2>
        <p class="link-cloud">
          {otherServices.map((otherService) => (
            <a href={url(`/locations/${location.slug}/${otherService.slug}`)}>{SERVICE_ICONS[otherService.slug]} {otherService.name}</a>
          ))}
        </p>
        {nearby.length > 0 && (
          <>
            <h2>{service.name} Near {location.name}</h2>
            <p class="link-cloud">
              {nearby.map((nearbyLocation) => (
                <a href={url(`/locations/${nearbyLocation.slug}/${service.slug}`)}>{nearbyLocation.name}, MN</a>
              ))}
            </p>
          </>
        )}
      </div>
      <aside class="card">
        <h2>Request a Free {service.slug === 'snow-removal' ? 'Snow ' : ''}Walkthrough in {location.name}</h2>
        <p>{service.slug === 'snow-removal' ? 'Tell us about your property.' : 'Tell us about your facility.'} {BUSINESS.responsePromise}</p>
        <QuoteForm variant={service.slug === 'snow-removal' ? 'snow' : 'cleaning'} />
      </aside>
    </div>
  </section>
  <CTA heading={`Need ${service.name.toLowerCase()} in ${location.name}?`} />
  {shouldIndex && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; }
  .link-cloud { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; }
  .link-cloud a { text-decoration: none; font-weight: 600; }
  .link-cloud a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
</style>
