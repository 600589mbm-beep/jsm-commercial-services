---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../../config';
import { LOCATIONS, CITY_LOCAL } from '../../../data/locations';
import { SERVICES, SERVICE_ICONS } from '../../../data/services';

export function getStaticPaths() {
  const paths = [];
  for (const location of LOCATIONS) {
    for (const service of SERVICES) {
      paths.push({
        params: { slug: location.slug, service: service.slug },
        props: { location, service },
      });
    }
  }
  return paths;
}

const { location, service } = Astro.props;

// Deterministic copy variation so 430 pages don't share one boilerplate intro.
const li = LOCATIONS.findIndex((l) => l.slug === location.slug);
const si = SERVICES.findIndex((s) => s.slug === service.slug);
const v = (li + si) % 3;

// Answer-first: every variant states who/what/where + the offer in sentence one.
const intros = [
  `${BUSINESS.name} provides ${service.name.toLowerCase()} for commercial properties in ${location.name}, MN — free on-site walkthrough, written scope, and pricing within 24 hours. Trained, background-checked crews serve ${location.name} and the rest of ${location.county} on a schedule built around your business. ${location.blurb}`,
  `${BUSINESS.name} delivers ${service.name.toLowerCase()} to businesses throughout ${location.name}, Minnesota, with a documented scope of work, supervisor inspections, and a free re-clean guarantee — quoted free from an on-site walkthrough. ${location.blurb}`,
  `Businesses in ${location.name}, MN get ${service.name.toLowerCase()} from ${BUSINESS.name} on month-to-month agreements — no long-term contracts — with a free walkthrough and written pricing within 24 hours. We serve all of ${location.county}. ${location.blurb}`,
];

const local = CITY_LOCAL[location.slug];
const nearby = LOCATIONS.filter((l) => l.county === location.county && l.slug !== location.slug).slice(0, 6);
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.name} in ${location.name}, MN`,
  description: service.short,
  areaServed: { '@type': 'City', name: `${location.name}, MN` },
  provider: { '@type': 'LocalBusiness', name: BUSINESS.name, telephone: BUSINESS.phone },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: new URL(url('/locations'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: location.name, item: new URL(url(`/locations/${location.slug}`), Astro.site).href },
    { '@type': 'ListItem', position: 4, name: service.name },
  ],
};
---

<Base
  title={`${service.name} in ${location.name}, MN | Free Quote in 24 Hrs — JSM`}
  description={`${service.name} in ${location.name}, MN — free walkthrough and written quote within 24 hours from JSM. Serving all of ${location.county}.`}
>
  <section class="section">
    <div class="container split">
      <div>
        <nav class="crumbs">
          <a href={url('/')}>Home</a> / <a href={url('/locations')}>Locations</a> /
          <a href={url(`/locations/${location.slug}`)}>{location.name}</a> / {service.name}
        </nav>
        <h1>{service.name} in {location.name}, MN</h1>
        <p>{intros[v]}</p>
        <p>{service.description}</p>
        {local && (
          <>
            <h2>Working in {location.name}</h2>
            <p>{local.context}</p>
          </>
        )}
        <h2>What's Included</h2>
        <ul class="checklist">
          {service.bullets.map((b) => <li>{b}</li>)}
        </ul>
        {(service.faq.length > 0 || local) && (
          <>
            <h2>Common Questions</h2>
            {(local?.faqs ?? []).map((f) => (
              <details class="faq-acc">
                <summary>{f.q}<span class="plus">+</span></summary>
                <p>{f.a}</p>
              </details>
            ))}
            {service.faq.map((f) => (
              <details class="faq-acc">
                <summary>{f.q}<span class="plus">+</span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </>
        )}
        <h2>Other Services in {location.name}</h2>
        <p class="link-cloud">
          {otherServices.map((s) => (
            <a href={url(`/locations/${location.slug}/${s.slug}`)}>{SERVICE_ICONS[s.slug]} {s.name}</a>
          ))}
        </p>
        {nearby.length > 0 && (
          <>
            <h2>{service.name} Near {location.name}</h2>
            <p class="link-cloud">
              {nearby.map((l) => (
                <a href={url(`/locations/${l.slug}/${service.slug}`)}>{l.name}, MN</a>
              ))}
            </p>
          </>
        )}
      </div>
      <aside class="card">
        <h2>Free {service.slug === 'snow-removal' ? 'Snow ' : ''}Quote in {location.name}</h2>
        <p>
          {service.slug === 'snow-removal'
            ? `Tell us about your property. ${BUSINESS.responsePromise}`
            : `Tell us about your facility. ${BUSINESS.responsePromise}`}
        </p>
        <QuoteForm variant={service.slug === 'snow-removal' ? 'snow' : 'cleaning'} />
      </aside>
    </div>
  </section>
  <CTA heading={`Need ${service.name.toLowerCase()} in ${location.name}?`} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
  }
  .link-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; }
  .link-cloud a { text-decoration: none; font-weight: 600; }
  .link-cloud a:hover { text-decoration: underline; }
</style>
