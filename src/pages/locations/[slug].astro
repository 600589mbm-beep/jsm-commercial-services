---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../config';
import { LOCATIONS } from '../../data/locations';
import { SERVICES } from '../../data/services';

export function getStaticPaths() {
  return LOCATIONS.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Commercial Cleaning & Janitorial Services in ${location.name}, MN`,
  description: location.blurb,
  areaServed: { '@type': 'City', name: `${location.name}, MN` },
  provider: {
    '@type': 'LocalBusiness',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
};
---

<Base
  title={`Commercial Cleaning in ${location.name}, MN | Free Quote in 24 Hrs — JSM`}
  description={`JSM provides commercial cleaning & janitorial in ${location.name}, MN (${location.county}). Free on-site walkthrough and written quote within 24 hours.`}
>
  <section class="section">
    <div class="container split">
      <div>
        <nav class="crumbs">
          <a href={url('/')}>Home</a> / <a href={url('/locations')}>Locations</a> / {location.name}
        </nav>
        <h1>Commercial Cleaning in {location.name}, MN</h1>
        <p>
          <strong>{BUSINESS.name} provides commercial cleaning and janitorial services in
          {location.name}, Minnesota</strong> — office cleaning, floor care, carpet, windows,
          disinfection, day porter, and snow removal, quoted free from an on-site walkthrough
          with a written scope and pricing within 24 hours. {location.blurb}
        </p>
        <p>
          Our crews are trained, insured, and background-checked, and every account throughout
          {location.name} and the rest of {location.county} gets a documented scope of work with
          supervisor inspections — on month-to-month agreements, never long-term contracts.
        </p>
        <h2>Services Available in {location.name}</h2>
        <ul class="checklist">
          {SERVICES.map((s) => (
            <li><a href={url(`/locations/${location.slug}/${s.slug}`)}>{s.name} in {location.name}</a></li>
          ))}
        </ul>
      </div>
      <aside class="card">
        <h2>Get a Free Quote in {location.name}</h2>
        <p>Tell us about your facility. {BUSINESS.responsePromise}</p>
        <QuoteForm />
      </aside>
    </div>
  </section>
  <CTA heading={`Need a cleaning crew in ${location.name}?`} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
