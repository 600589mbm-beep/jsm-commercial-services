---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { BUSINESS, url } from '../config';
---

<Base
  title={`Contact Us | ${BUSINESS.name}`}
  description={`Contact ${BUSINESS.name} for commercial cleaning in the ${BUSINESS.serviceArea}. Call ${BUSINESS.phone} or send us a message.`}
>
  <section class="section">
    <div class="container split">
      <div>
        <nav class="crumbs"><a href={url('/')}>Home</a> / Contact</nav>
        <h1>Contact Us</h1>
        <p>Questions, quotes, or service requests — reach us any way that's convenient.</p>
        <h2>Phone</h2>
        <p><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></p>
        <h2>Email</h2>
        <p>
          Sales: <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a><br />
          General: <a href={`mailto:${BUSINESS.infoEmail}`}>{BUSINESS.infoEmail}</a>
        </p>
        <h2>Hours</h2>
        <p>{BUSINESS.hours}</p>
        <h2>Address</h2>
        <p>
          {BUSINESS.address.street}<br />
          {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
        </p>
        <iframe
          class="map"
          src={`https://www.google.com/maps?q=${encodeURIComponent(
            `${BUSINESS.name}, ${BUSINESS.address.street}, ${BUSINESS.address.city}, ${BUSINESS.address.state} ${BUSINESS.address.zip}`
          )}&output=embed`}
          width="100%"
          height="260"
          style="border:0; border-radius: 12px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map of ${BUSINESS.name} in ${BUSINESS.address.city}, ${BUSINESS.address.state}`}
        ></iframe>
        <h2>Service Area</h2>
        <p>{BUSINESS.serviceArea} — <a href={url('/locations')}>see all cities</a></p>
      </div>
      <aside class="card">
        <h2>Send a Message</h2>
        <QuoteForm />
      </aside>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .split h2 { font-size: 1.05rem; margin-top: 1.5rem; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
