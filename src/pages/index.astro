---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import TrustBar from '../components/TrustBar.astro';
import { BUSINESS, url } from '../config';
import { SERVICES, SERVICE_ICONS } from '../data/services';
import { INDUSTRIES, INDUSTRY_ICONS } from '../data/industries';
import { LOCATIONS } from '../data/locations';
import { TESTIMONIALS } from '../data/testimonials';

const FEATURED_SERVICES = SERVICES.filter((service) =>
  [
    'janitorial-services',
    'office-cleaning',
    'day-porter-services',
    'floor-care',
    'medical-office-cleaning',
    'industrial-warehouse-cleaning',
  ].includes(service.slug)
);

const FAQS = [
  {
    q: 'Can JSM replace a large national janitorial company?',
    a: 'Yes. JSM is built for Twin Cities organizations that want an enterprise-style scope, assigned crews, supervisor inspections, clear escalation, and consistent reporting without layers of national account management. We start with a free walkthrough and can quote your current scope line by line.',
  },
  {
    q: 'Do you support multiple locations?',
    a: 'Yes. For organizations with multiple Twin Cities locations, we can create one core cleaning standard with site-specific schedules and addenda, a primary account contact, and coordinated startup planning across the portfolio.',
  },
  {
    q: 'How do you control cleaning quality?',
    a: 'Each account starts with a written scope and site checklist. Crews follow the documented plan, supervisors perform quality inspections, and service concerns go to one point of contact. If a completed visit misses the written scope, we re-clean the affected area at no charge.',
  },
  {
    q: 'Do you offer janitorial contracts in the Twin Cities?',
    a: `Yes. We provide recurring commercial cleaning and contract janitorial across the ${BUSINESS.serviceArea}. Agreements are month-to-month with a written scope, schedule, and pricing—no long-term lock-in.`,
  },
  {
    q: 'How much does commercial cleaning cost?',
    a: 'Pricing depends on square footage, facility type, service frequency, occupancy, and the scope of work. We provide a free on-site walkthrough and written proposal so the price is based on your building rather than a generic estimate.',
  },
  {
    q: 'Are your cleaners insured and background-checked?',
    a: 'Yes. Crew members are background-checked, trained, and uniformed. JSM carries general liability and workers’ compensation coverage and can provide a certificate of insurance and additional-insured documentation on request.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title={`Commercial Cleaning & Janitorial — Twin Cities, MN | ${BUSINESS.name}`}
  description={`Enterprise-level commercial cleaning with local accountability. Written scopes, assigned crews, supervisor inspections, and month-to-month service across the Twin Cities.`}
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-a" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-b" aria-hidden="true"></div>
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="kicker">Twin Cities commercial cleaning · Owner-led accountability</p>
        <h1>National-level cleaning standards. <span class="accent">Local accountability.</span></h1>
        <p class="sub">
          JSM gives facility leaders the structure they expect from a major provider—documented
          scopes, assigned crews, supervisor inspections, and clear escalation—with a local team
          that answers directly and acts quickly.
        </p>
        <div class="buttons">
          <a class="btn btn-primary" href={url('/quote')}>Request a Facility Walkthrough</a>
          <a class="btn btn-outline" href={url('/facility-care-program')}>See the JSM Care Program</a>
        </div>
        <TrustBar />
      </div>
      <aside class="hero-panel" aria-label="JSM service commitments">
        <p class="panel-label">The JSM standard</p>
        <div class="commitment"><span>01</span><div><strong>Written scope</strong><small>Room-by-room tasks, frequency, and expectations.</small></div></div>
        <div class="commitment"><span>02</span><div><strong>Assigned team</strong><small>Trained crews scheduled around your operations.</small></div></div>
        <div class="commitment"><span>03</span><div><strong>Quality control</strong><small>Supervisor inspections and direct issue escalation.</small></div></div>
        <div class="commitment"><span>04</span><div><strong>Accountability</strong><small>Free re-clean if a visit misses the written scope.</small></div></div>
        <a href={BUSINESS.phoneHref}>Speak directly with JSM: {BUSINESS.phone}</a>
      </aside>
    </div>
  </section>

  <section class="proof-strip" aria-label="JSM service advantages">
    <div class="container proof-grid">
      <span>✓ Month-to-month agreements</span>
      <span>✓ One accountable contact</span>
      <span>✓ Custom facility checklists</span>
      <span>✓ Twin Cities service coverage</span>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head wide-head">
        <p class="eyebrow">Built for facility outcomes</p>
        <h2>A cleaning program should do more than make the building look clean</h2>
        <p>
          The right partner protects your facility, supports occupants, reduces management time,
          and gives you a clear way to measure whether the work is getting done.
        </p>
      </div>
      <div class="outcome-grid">
        <article class="outcome-card">
          <span>01</span>
          <h3>Protect the first impression</h3>
          <p>Entrances, restrooms, common areas, and high-touch spaces stay presentation-ready for tenants, employees, customers, and visitors.</p>
        </article>
        <article class="outcome-card">
          <span>02</span>
          <h3>Preserve facility assets</h3>
          <p>Planned floor, carpet, glass, and surface care helps reduce premature wear and avoid reactive restoration costs.</p>
        </article>
        <article class="outcome-card">
          <span>03</span>
          <h3>Reduce vendor-management time</h3>
          <p>One scope, one accountable contact, and documented follow-through replace repeated emails and unresolved service tickets.</p>
        </article>
        <article class="outcome-card">
          <span>04</span>
          <h3>Support safer operations</h3>
          <p>Consistent restroom care, high-touch cleaning, spill response, and site-specific procedures support a healthier facility.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section program-section">
    <div class="container program-layout">
      <div>
        <p class="eyebrow light">The JSM Facility Care Program</p>
        <h2>Enterprise structure without enterprise layers</h2>
        <p class="program-lead">
          Every recurring account is built around five operating disciplines. They make expectations
          visible before startup and create a direct path for correcting problems after service begins.
        </p>
        <a class="btn btn-primary" href={url('/facility-care-program')}>Explore the Complete Program</a>
      </div>
      <ol class="program-list">
        <li><span>1</span><div><strong>Facility discovery</strong><p>Walkthrough, priorities, access, safety, occupancy, and pain points.</p></div></li>
        <li><span>2</span><div><strong>Scope engineering</strong><p>Tasks, frequencies, staffing plan, schedule, and measurable expectations.</p></div></li>
        <li><span>3</span><div><strong>Controlled startup</strong><p>Site orientation, crew assignment, supplies, keys, contacts, and launch checks.</p></div></li>
        <li><span>4</span><div><strong>Quality verification</strong><p>Supervisor inspections, checklist review, issue tracking, and re-clean response.</p></div></li>
        <li><span>5</span><div><strong>Continuous improvement</strong><p>Adjust the plan as traffic, seasons, occupancy, or facility needs change.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Core capabilities</p>
        <h2>One accountable partner for daily cleaning and specialty care</h2>
        <p>Build a recurring program, schedule periodic projects, or combine both under one facility plan.</p>
      </div>
      <div class="grid grid-3">
        {FEATURED_SERVICES.map((service) => (
          <article class="card">
            <span class="icon">{SERVICE_ICONS[service.slug]}</span>
            <h3><a href={url(`/services/${service.slug}`)}>{service.name}</a></h3>
            <p>{service.short}</p>
          </article>
        ))}
      </div>
      <p class="center-action"><a class="btn btn-navy" href={url('/services')}>View All {SERVICES.length} Services</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container portfolio-layout">
      <div>
        <p class="eyebrow">Multi-site and portfolio support</p>
        <h2>One cleaning standard across multiple Twin Cities locations</h2>
        <p>
          Regional organizations should not have to manage a different vendor process at every
          address. JSM can develop a common operating standard with site-specific schedules and
          requirements for each location.
        </p>
        <ul class="checklist">
          <li>One primary account contact and coordinated startup plan</li>
          <li>Core scope standards with site-specific addenda</li>
          <li>Consistent inspection criteria across the portfolio</li>
          <li>Consolidated service planning for recurring and project work</li>
          <li>Local routing across {LOCATIONS.length} Twin Cities communities</li>
        </ul>
        <a class="btn btn-primary" href={url('/quote')}>Discuss Multiple Locations</a>
      </div>
      <aside class="portfolio-card">
        <p class="panel-label">Designed for</p>
        <ul>
          <li>Commercial real estate portfolios</li>
          <li>Medical and dental groups</li>
          <li>Retail and branch networks</li>
          <li>Schools and education organizations</li>
          <li>Industrial and warehouse operators</li>
          <li>Professional office groups</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Industry-specific planning</p>
        <h2>Cleaning built around how your facility operates</h2>
        <p>Different facilities carry different risks, traffic patterns, standards, and occupant expectations. Your scope should reflect them.</p>
      </div>
      <div class="industry-grid">
        {INDUSTRIES.map((industry) => (
          <a href={url(`/industries/${industry.slug}`)}>
            <span>{INDUSTRY_ICONS[industry.slug]}</span>
            <strong>{industry.name}</strong>
            <small>View solutions →</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section comparison-section">
    <div class="container comparison-layout">
      <div>
        <p class="eyebrow">A stronger local alternative</p>
        <h2>When a national provider feels too far away</h2>
        <p>
          Large providers can offer scale. JSM is designed for Twin Cities facilities that value
          disciplined service delivery but need faster access to the people responsible for the account.
        </p>
      </div>
      <div class="comparison-table" role="table" aria-label="National provider model compared with JSM">
        <div class="comparison-row comparison-head" role="row">
          <span role="columnheader">What matters</span><span role="columnheader">Typical layered model</span><span role="columnheader">JSM approach</span>
        </div>
        <div class="comparison-row" role="row"><strong role="cell">Account access</strong><span role="cell">Central queue or several handoffs</span><span role="cell">One local point of contact</span></div>
        <div class="comparison-row" role="row"><strong role="cell">Scope flexibility</strong><span role="cell">Standardized around a large system</span><span role="cell">Built around your actual building</span></div>
        <div class="comparison-row" role="row"><strong role="cell">Issue response</strong><span role="cell">Escalation through account layers</span><span role="cell">Direct correction and re-clean path</span></div>
        <div class="comparison-row" role="row"><strong role="cell">Agreement</strong><span role="cell">Often designed for long commitments</span><span role="cell">Month-to-month accountability</span></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container resource-layout">
      <div>
        <p class="eyebrow">Procurement-ready resources</p>
        <h2>Evaluate cleaning vendors with a clearer process</h2>
        <p>
          Use JSM’s free cost guides, RFP template, cleaning checklist, and vendor scorecard—even
          when you are comparing us with another provider.
        </p>
      </div>
      <div class="resource-actions">
        <a class="resource-link" href={url('/resources/templates')}><strong>Janitorial RFP & scorecard</strong><span>Build a comparable bid process →</span></a>
        <a class="resource-link" href={url('/resources/cleaning-cost-calculator')}><strong>Cleaning cost calculator</strong><span>Estimate a realistic budget →</span></a>
        <a class="resource-link" href={url('/resources')}><strong>Facility manager resource center</strong><span>See all guides and tools →</span></a>
      </div>
    </div>
  </section>

  {TESTIMONIALS.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>What Clients Say</h2></div>
        <div class="grid grid-3">
          {TESTIMONIALS.map((testimonial) => (
            <blockquote class="card testimonial">
              <p>“{testimonial.quote}”</p>
              <footer>— {testimonial.name}, {testimonial.company}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container faq-layout">
      <div class="section-head">
        <p class="eyebrow">Questions from facility leaders</p>
        <h2>Commercial cleaning questions, answered</h2>
      </div>
      <div class="faq-wrap">
        {FAQS.map((faq) => (
          <details class="faq-acc">
            <summary>{faq.q}<span class="plus">+</span></summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section alt">
    <div class="container service-area-layout">
      <div>
        <p class="eyebrow">Local coverage</p>
        <h2>Serving {LOCATIONS.length} Twin Cities communities</h2>
        <p>Local routing supports responsive service from Apple Valley and Eagan to Minneapolis, St. Paul, Bloomington, Eden Prairie, Stillwater, and beyond.</p>
      </div>
      <a class="btn btn-navy" href={url('/locations')}>View Every Service Area</a>
    </div>
  </section>

  <CTA heading="Build a cleaning program your facility can rely on" />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg, #081c2d 0%, var(--navy) 55%, #123c52 100%);
    color: #fff;
    padding: 6rem 0 5rem;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
    pointer-events: none;
  }
  .hero-glow { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; }
  .hero-glow-a { width: 460px; height: 460px; right: -160px; top: -170px; background: rgba(25,163,154,.35); }
  .hero-glow-b { width: 340px; height: 340px; left: -170px; bottom: -170px; background: rgba(31,111,178,.28); }
  .hero-layout { position: relative; display: grid; grid-template-columns: minmax(0,1.35fr) minmax(330px,.65fr); gap: 4rem; align-items: center; }
  .kicker, .eyebrow { color: var(--teal-dark); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .kicker { color: var(--teal-bright); }
  .eyebrow.light { color: var(--teal-bright); }
  .hero h1 { color: #fff; max-width: 850px; font-size: clamp(2.6rem, 6vw, 4.7rem); }
  .sub { color: #c8d7e3; font-size: 1.15rem; max-width: 740px; }
  .buttons { display: flex; gap: .9rem; flex-wrap: wrap; margin: 1.9rem 0 2rem; }
  .hero-panel { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); border-radius: 18px; padding: 1.5rem; backdrop-filter: blur(14px); box-shadow: 0 22px 60px rgba(0,0,0,.25); }
  .panel-label { color: var(--teal-bright); font-size: .75rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .commitment { display: grid; grid-template-columns: 2.6rem 1fr; gap: .9rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.13); }
  .commitment > span { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: rgba(46,230,200,.15); color: var(--teal-bright); font-size: .72rem; font-weight: 800; }
  .commitment strong { display: block; color: #fff; }
  .commitment small { display: block; color: #c8d7e3; line-height: 1.45; margin-top: .2rem; }
  .hero-panel > a { display: inline-block; color: #fff; font-weight: 700; margin-top: 1.2rem; }
  .proof-strip { background: #0a2135; color: #d9e7f0; border-top: 1px solid rgba(255,255,255,.08); }
  .proof-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; padding-top: 1.1rem; padding-bottom: 1.1rem; text-align: center; font-size: .88rem; font-weight: 700; }
  .wide-head { max-width: 850px; }
  .outcome-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
  .outcome-card { border-top: 3px solid var(--teal); padding: 1.4rem 1.1rem; background: #fff; box-shadow: var(--shadow); border-radius: 0 0 var(--radius) var(--radius); }
  .outcome-card > span { color: var(--teal-dark); font-weight: 800; font-size: .75rem; }
  .outcome-card p { color: var(--text-soft); margin: 0; }
  .program-section { background: linear-gradient(135deg, var(--navy-dark), var(--navy)); color: #fff; }
  .program-section h2 { color: #fff; }
  .program-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 4rem; align-items: start; }
  .program-lead { color: #c8d7e3; font-size: 1.08rem; }
  .program-list { list-style: none; margin: 0; padding: 0; }
  .program-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.13); }
  .program-list li > span { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 10px; background: var(--teal); color: #fff; font-weight: 800; }
  .program-list strong { color: #fff; font-size: 1.05rem; }
  .program-list p { color: #c8d7e3; margin: .15rem 0 0; }
  .center-action { text-align: center; margin-top: 2rem; }
  .portfolio-layout { display: grid; grid-template-columns: 1.25fr .75fr; gap: 4rem; align-items: center; }
  .portfolio-card { background: linear-gradient(160deg, var(--navy), var(--navy-dark)); color: #fff; border-radius: 18px; padding: 2rem; box-shadow: var(--shadow-lift); }
  .portfolio-card ul { list-style: none; padding: 0; margin: 0; }
  .portfolio-card li { padding: .8rem 0 .8rem 1.6rem; border-bottom: 1px solid rgba(255,255,255,.13); position: relative; }
  .portfolio-card li::before { content: '→'; position: absolute; left: 0; color: var(--teal-bright); }
  .industry-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
  .industry-grid a { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .8rem; background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem; text-decoration: none; box-shadow: var(--shadow); transition: transform .25s var(--ease-out), border-color .25s; }
  .industry-grid a:hover { transform: translateY(-4px); border-color: var(--teal); }
  .industry-grid a > span { font-size: 1.5rem; }
  .industry-grid strong { color: var(--navy); }
  .industry-grid small { grid-column: 2; color: var(--teal-dark); font-weight: 700; }
  .comparison-section { background: #eef4f7; }
  .comparison-layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: 3rem; align-items: start; }
  .comparison-table { border-radius: 14px; overflow: hidden; border: 1px solid var(--border); background: #fff; box-shadow: var(--shadow); }
  .comparison-row { display: grid; grid-template-columns: .7fr 1fr 1fr; }
  .comparison-row > * { padding: 1rem; border-bottom: 1px solid var(--border); }
  .comparison-row > * + * { border-left: 1px solid var(--border); }
  .comparison-head { background: var(--navy); color: #fff; font-weight: 800; }
  .comparison-row:not(.comparison-head) span:last-child { background: rgba(25,163,154,.07); color: var(--navy); font-weight: 700; }
  .resource-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; align-items: center; }
  .resource-actions { display: grid; gap: .8rem; }
  .resource-link { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: 10px; background: #fff; text-decoration: none; }
  .resource-link strong { color: var(--navy); }
  .resource-link span { color: var(--teal-dark); font-size: .88rem; font-weight: 700; text-align: right; }
  .faq-layout { display: grid; grid-template-columns: .7fr 1.3fr; gap: 3rem; }
  .faq-wrap { max-width: 820px; }
  .service-area-layout { display: flex; justify-content: space-between; gap: 2rem; align-items: center; }
  .service-area-layout > div { max-width: 700px; }
  .testimonial { margin: 0; }
  .testimonial footer { color: var(--text-soft); font-size: .88rem; font-weight: 600; }
  @media (max-width: 980px) {
    .hero-layout, .program-layout, .portfolio-layout, .comparison-layout, .resource-layout, .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .outcome-grid, .industry-grid { grid-template-columns: repeat(2,1fr); }
    .proof-grid { grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 640px) {
    .hero { padding: 4.5rem 0 3.5rem; }
    .hero h1 { font-size: clamp(2.35rem, 13vw, 3.3rem); }
    .outcome-grid, .industry-grid, .proof-grid { grid-template-columns: 1fr; text-align: left; }
    .comparison-row { grid-template-columns: 1fr; }
    .comparison-head { display: none; }
    .comparison-row > * + * { border-left: 0; padding-top: .35rem; }
    .comparison-row { padding: .8rem; border-bottom: 1px solid var(--border); }
    .comparison-row > * { border-bottom: 0; padding: .35rem; }
    .resource-link, .service-area-layout { align-items: flex-start; flex-direction: column; }
    .resource-link span { text-align: left; }
  }
</style>
