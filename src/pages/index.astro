---
import Base from '../layouts/Base.astro';
import FacilityHeroVisual from '../components/FacilityHeroVisual.astro';
import TrustEvidence from '../components/TrustEvidence.astro';
import IllustrationGallery from '../components/IllustrationGallery.astro';
import { BUSINESS, url } from '../config';
import { SERVICES } from '../data/services';
import { INDUSTRIES } from '../data/industries';
import { LOCATIONS } from '../data/locations';
import { TESTIMONIALS } from '../data/testimonials';

const featured = SERVICES.filter((service) =>
  [
    'janitorial-services',
    'office-cleaning',
    'day-porter-services',
    'floor-care',
    'medical-office-cleaning',
    'industrial-warehouse-cleaning',
  ].includes(service.slug)
);

const faqs = [
  {
    q: 'How do I request a commercial cleaning walkthrough?',
    a: 'Open the walkthrough form, describe your building, choose your cleaning frequency and suggest a date and time window. JSM will contact you to confirm availability. Selecting a date is a request, not a confirmed appointment.',
  },
  {
    q: 'Can I request cleaning from one to seven days per week?',
    a: 'Yes. The request form lets you specify one through seven days per week, choose preferred weekdays and explain your preferred cleaning hours. JSM reviews the scope and confirms a service schedule in the proposal. One-time and custom schedules can also be requested.',
  },
  {
    q: 'Can I share an existing RFP or building scope?',
    a: 'Yes. Add a document link or paste your RFP requirements in the walkthrough form. File attachments can be emailed separately to JSM with your building name and address. Include the bid deadline and any site-visit requirements.',
  },
  {
    q: 'What determines the price of commercial cleaning?',
    a: 'Your building type, cleanable square footage, traffic, restrooms, floor surfaces, cleaning frequency and required tasks all affect the scope. A walkthrough helps establish the requirements before JSM prepares a written proposal.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Base
  title="Commercial Cleaning & Janitorial in the Twin Cities | JSM"
  description="Commercial cleaning for Twin Cities offices, retail, clinics and managed properties. Set your cleaning frequency and request a free JSM building walkthrough."
>
  <section class="home-hero">
    <div class="hero-grid-art" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <div class="container hero-layout">
      <div class="hero-copy">
        <div class="hero-kicker"><span></span><p class="eyebrow">TWIN CITIES COMMERCIAL CLEANING</p></div>
        <h1>Commercial Cleaning<br /><em>in the Twin Cities.</em></h1>
        <p class="hero-slogan">A cleaner building. A simpler workday.</p>
        <p class="hero-description">
          Commercial cleaning and janitorial services built around your property, your people and
          your schedule. One local team. A clear, written scope.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary hero-primary" href={url('/quote')}>
            <span>Request a Free Walkthrough</span><i aria-hidden="true">↗</i>
          </a>
          <a class="text-link" href={url('/quote/#quick-inquiry')}>Request a quick callback →</a>
        </div>
        <p class="hero-caption">Tell us your building type. Choose your cleaning days. Share your RFP.</p>
        <div class="hero-proof" aria-label="JSM service advantages">
          <span><i aria-hidden="true">✓</i> Owner-led service</span>
          <span><i aria-hidden="true">✓</i> Twin Cities coverage</span>
          <span><i aria-hidden="true">✓</i> Written cleaning scopes</span>
        </div>
      </div>
      <FacilityHeroVisual />
    </div>
  </section>

  <section class="intro-strip" aria-label="Facilities served">
    <div class="container">
      <span>BUILT FOR THE WAY YOUR PROPERTY WORKS</span>
      <p>Offices <b>·</b> Managed properties <b>·</b> Retail <b>·</b> Clinics <b>·</b> Warehouses</p>
    </div>
  </section>

  <section class="home-section walkthrough-offer" aria-labelledby="walkthrough-offer-heading">
    <div class="container">
      <p class="eyebrow">SEPTEMBER 30–OCTOBER 31, 2026</p>
      <h2 id="walkthrough-offer-heading">Free commercial cleaning walkthrough</h2>
      <p>Request a free, no-obligation commercial cleaning walkthrough for your Twin Cities facility. JSM Commercial Services will review your building, cleaning priorities and preferred schedule, then prepare a written proposal based on the agreed scope.</p>
      <p>Suitable for offices, clinics, retail stores, warehouses and managed properties.</p>
      <p><strong>Submit your request September 30–October 31, 2026.</strong> No purchase required. Visit date and service availability are confirmed by JSM.</p>
      <a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough →</a>
    </div>
  </section>

  <section class="home-section process-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">THE RIGHT START</p><h2>Less back-and-forth.<br />A better building walkthrough.</h2></div>
        <p>Give us the details once. We will use them to prepare for your site visit and discuss a cleaning plan that fits.</p>
      </div>
      <div class="steps-grid">
        <article>
          <div class="step-visual visual-building" aria-hidden="true"><span></span><i></i></div>
          <span class="step-number">01</span>
          <h3>Describe your building</h3>
          <p>Tell us the property type, address, cleanable square footage and spaces that need attention.</p>
        </article>
        <article>
          <div class="step-visual visual-calendar" aria-hidden="true"><span></span><i></i></div>
          <span class="step-number">02</span>
          <h3>Choose your cleaning days</h3>
          <p>Specify exactly how many days per week you need cleaned, preferred weekdays and cleaning hours.</p>
        </article>
        <article>
          <div class="step-visual visual-scope" aria-hidden="true"><span></span><i></i></div>
          <span class="step-number">03</span>
          <h3>Request a visit. Share the scope.</h3>
          <p>Pick a preferred walkthrough date and include your RFP link, requirements or proposal deadline.</p>
        </article>
      </div>
      <a class="inline-action" href={url('/quote')}>Start your free walkthrough request →</a>
    </div>
  </section>

  <section class="home-section services-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">COMMERCIAL CLEANING SERVICES</p><h2>Daily essentials.<br />Specialty care when you need it.</h2></div>
        <a class="inline-action" href={url('/services')}>View all services →</a>
      </div>
      <div class="services-grid">
        {featured.map((service, index) => (
          <a class="service-tile" href={url(`/services/${service.slug}`)}>
            <div class="service-visual" aria-hidden="true">
              <span>0{index + 1}</span>
              <div class="service-shape"><i></i><b></b></div>
              <em>↗</em>
            </div>
            <div class="service-copy">
              <h3>{service.name}</h3>
              <p>{service.short}</p>
              <span class="tile-more">Explore service <b aria-hidden="true">→</b></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IllustrationGallery selected={['office', 'clinic', 'retail', 'warehouse']} />

  <section class="home-section schedule-section">
    <div class="container schedule-layout">
      <div class="schedule-copy">
        <p class="eyebrow">YOUR FREQUENCY. NOT A GUESS.</p>
        <h2>How many days<br />does your building need?</h2>
        <p class="section-lead">Request cleaning one through seven days per week, a one-time project or a custom schedule. Your proposal should spell out both the tasks and how often they happen.</p>
        <p>Share your preferred days and cleaning window. We will review traffic, restrooms, floor surfaces and operating hours during the walkthrough before confirming the plan.</p>
        <a class="inline-action" href={url('/commercial-cleaning-twin-cities')}>Compare building types and cleaning schedules →</a>
      </div>
      <div class="schedule-shell">
        <div class="schedule-tab"><span>JSM</span><p>FACILITY SCHEDULE</p><i aria-hidden="true"></i></div>
        <div class="schedule-panel">
          <span class="eyebrow">ILLUSTRATIVE WEEKLY SCHEDULE</span>
          <h3>A plan you can see at a glance.</h3>
          <div class="sample-week">
            {['M','T','W','T','F','S','S'].map((day, index) => (
              <span class:list={{ selected: index < 5 }}><small>{day}</small><strong>{index < 5 ? '✓' : '—'}</strong></span>
            ))}
          </div>
          <div class="scope-lines">
            <div class="scope-line"><span>Cleaning visits</span><strong>5 days / week</strong></div>
            <div class="scope-line"><span>Timing</span><strong>After business hours</strong></div>
            <div class="scope-line"><span>Scope</span><strong>Defined by your building</strong></div>
          </div>
          <p>Example only. Not a booking calendar or a guaranteed service slot.</p>
          <a class="btn btn-primary" href={url('/quote')}>Choose Your Cleaning Schedule →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="rfp-banner">
    <div class="rfp-grid" aria-hidden="true"></div>
    <div class="container rfp-layout">
      <div>
        <p class="eyebrow">FOR PROPERTY MANAGERS & PROCUREMENT TEAMS</p>
        <h2>Your building documentation<br />belongs with your request.</h2>
        <p>Already have an RFP, floor plan, current cleaning scope or location schedule? Add a link or paste your requirements in the walkthrough form. Email attachments separately with the building name and address.</p>
        <a class="btn btn-primary" href={url('/quote')}>Start a Walkthrough & RFP Request →</a>
      </div>
      <div class="document-stack">
        <div class="document-head"><span class="doc-icon" aria-hidden="true">▤</span><p><small>REQUEST PACKAGE</small><strong>What to send JSM</strong></p></div>
        <div><span>01</span><strong>Building details & floor plans</strong><i aria-hidden="true">✓</i></div>
        <div><span>02</span><strong>Tasks & cleaning frequencies</strong><i aria-hidden="true">✓</i></div>
        <div><span>03</span><strong>Bid instructions & deadlines</strong><i aria-hidden="true">✓</i></div>
        <p>Keep confidential documents access-restricted. Do not share keys, access codes or personal information.</p>
      </div>
    </div>
  </section>

  <section class="home-section industries-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">FACILITY-SPECIFIC PLANNING</p><h2>Different buildings.<br />Different cleaning priorities.</h2></div>
        <a class="inline-action" href={url('/industries')}>Explore all facility types →</a>
      </div>
      <div class="industry-links">
        {INDUSTRIES.map((industry, index) => (
          <a href={url(`/industries/${industry.slug}`)}>
            <span class="industry-index">{String(index + 1).padStart(2, '0')}</span>
            <strong>{industry.name}</strong>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section resources-section">
    <div class="container resource-layout">
      <div class="resource-copy">
        <p class="eyebrow">MAKE A MORE INFORMED DECISION</p>
        <h2>A clear scope makes<br />a stronger comparison.</h2>
        <p>Review the operating approach, prepare your RFP, or plan the switch from an existing provider.</p>
        <div class="resource-visual" aria-hidden="true"><span></span><i></i><b></b></div>
      </div>
      <div class="resource-links">
        <a href={url('/facility-care-program')}><span>01</span><div><strong>The JSM Facility Care Program</strong><small>Understand scope, startup and quality checks</small></div><i aria-hidden="true">→</i></a>
        <a href={url('/switching-cleaning-companies')}><span>02</span><div><strong>Switching cleaning providers</strong><small>Plan a practical handover for your property</small></div><i aria-hidden="true">→</i></a>
        <a href={url('/resources/templates')}><span>03</span><div><strong>RFP templates & vendor scorecard</strong><small>Compare proposals using the same requirements</small></div><i aria-hidden="true">→</i></a>
        <a href={url('/janitorial-contracts')}><span>04</span><div><strong>Commercial janitorial contracts</strong><small>Explore recurring service and written scopes</small></div><i aria-hidden="true">→</i></a>
      </div>
    </div>
  </section>

  <TrustEvidence />

  {TESTIMONIALS.length > 0 && (
    <section class="home-section">
      <div class="container">
        <h2>From JSM clients</h2>
        <div class="services-grid">
          {TESTIMONIALS.map((testimonial) => (
            <blockquote class="service-tile"><p>“{testimonial.quote}”</p><footer>{testimonial.name}, {testimonial.company}</footer></blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="home-section faq-section">
    <div class="container faq-layout">
      <div class="faq-intro">
        <p class="eyebrow">BEFORE YOUR WALKTHROUGH</p>
        <h2>A few helpful answers.</h2>
        <p>Have a building-specific question?<br /><a href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a></p>
        <div class="faq-visual" aria-hidden="true"><span>?</span><i></i></div>
      </div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="home-faq">
            <summary><span>0{index + 1}</span>{faq.q}<i aria-hidden="true">+</i></summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="coverage-section">
    <div class="coverage-art" aria-hidden="true"><span></span><i></i><b></b></div>
    <div class="container coverage-layout">
      <div>
        <p class="eyebrow">LOCAL SERVICE. TWIN CITIES REACH.</p>
        <h2>Commercial cleaning across the metro.</h2>
        <p>From Apple Valley and Eagan to Minneapolis, St. Paul, Bloomington and Edina. Share your address so we can review your building’s service needs.</p>
        <div class="city-links">{LOCATIONS.slice(0, 8).map((location) => <a href={url(`/locations/${location.slug}`)}>{location.name}</a>)}</div>
        <a class="inline-action" href={url('/locations')}>View the full service area →</a>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="container">
      <div><p class="eyebrow">LET’S START WITH YOUR BUILDING</p><h2>Tell us what clean<br />needs to look like.</h2></div>
      <div class="closing-action"><a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough <span aria-hidden="true">→</span></a><p>Preferred dates are confirmed by JSM.<br />{BUSINESS.responsePromise}</p></div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

<style>
  .hero-slogan { color:var(--brand-dark); font-size:1.2rem; font-weight:700; margin:0 0 1rem; }
  .eyebrow{font-size:.68rem;font-weight:800;letter-spacing:.145em;color:var(--brand);margin:0 0 1rem}.home-hero{position:relative;background:linear-gradient(135deg,var(--brand-surface) 0%,var(--bg-alt) 48%,var(--brand-surface) 100%);padding:5.2rem 0 5rem;overflow:hidden}.hero-grid-art{position:absolute;inset:0;background-image:linear-gradient(rgba(var(--brand-rgb), 0.031) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--brand-rgb), 0.031) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,#000 0%,#0009 55%,transparent 94%);pointer-events:none}.hero-orb{position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}.hero-orb-a{width:430px;height:430px;right:6%;top:-22%;background:radial-gradient(circle,rgba(var(--brand-light-rgb), 0.157) 0,rgba(var(--brand-light-rgb), 0.098) 48%,transparent 72%)}.hero-orb-b{width:260px;height:260px;left:-8%;bottom:-24%;background:radial-gradient(circle,rgba(var(--brand-rgb), 0.094) 0,transparent 70%)}.hero-layout{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);gap:4.8rem;align-items:center}.hero-kicker{display:flex;align-items:center;gap:.7rem}.hero-kicker>span{width:30px;height:2px;background:var(--brand)}.hero-kicker .eyebrow{margin:0}.hero-copy h1{font-size:clamp(3rem,5.2vw,4.75rem);letter-spacing:-.06em;line-height:1.01;margin:1rem 0 1.45rem;color:var(--navy);max-width:700px}.hero-copy h1 em{font-style:normal;color:var(--brand);position:relative}.hero-copy h1 em:after{content:'';position:absolute;left:.02em;right:.02em;bottom:.02em;height:.1em;border-radius:10px;background:var(--brand-tint);z-index:-1;opacity:.7}.hero-description{font-size:1.08rem;max-width:570px;line-height:1.8;color:var(--text-soft)}.hero-actions{display:flex;align-items:center;gap:1.2rem;margin:1.9rem 0 .9rem}.home-hero .btn-primary,.schedule-panel .btn-primary,.rfp-banner .btn-primary,.closing-section .btn-primary{background:linear-gradient(135deg,var(--brand),var(--brand-dark));box-shadow:0 10px 24px rgba(var(--brand-rgb), .18);border-radius:.7rem}.hero-primary{display:flex!important;align-items:center;gap:1.2rem;padding:.95rem 1.15rem .95rem 1.35rem}.hero-primary i{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#ffffff18;font-style:normal}.text-link,.inline-action{font-weight:800;color:var(--brand-dark);font-size:.88rem;text-underline-offset:4px}.hero-caption{font-size:.77rem;color:var(--text-soft);max-width:440px}.hero-proof{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.5rem}.hero-proof span{display:flex;align-items:center;gap:.38rem;padding:.48rem .65rem;border:1px solid var(--brand-border);border-radius:999px;background:#ffffffa8;color:var(--text-soft);font-size:.7rem;box-shadow:0 5px 16px rgba(var(--navy-rgb), 0.063)}.hero-proof i{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;background:var(--brand-soft);color:var(--brand);font-size:.59rem;font-style:normal}.intro-strip{border-top:1px solid var(--brand-border);border-bottom:1px solid var(--brand-border);background:#fff;padding:1.25rem 0}.intro-strip .container{display:flex;justify-content:space-between;align-items:center;gap:1.5rem}.intro-strip span{font-size:.56rem;letter-spacing:.13em;font-weight:800;color:var(--text-soft)}.intro-strip p{font-size:.8rem;margin:0;color:var(--navy-raised)}.intro-strip b{font-weight:400;color:var(--brand-light);margin:0 .7rem}.home-section{padding:5.2rem 0}.section-heading{display:flex;justify-content:space-between;gap:3rem;align-items:end;margin-bottom:2.6rem}.section-heading h2,.schedule-layout h2,.resource-layout h2,.faq-layout h2,.rfp-layout h2{font-size:clamp(1.9rem,3.2vw,2.85rem);letter-spacing:-.045em;line-height:1.08}.section-heading>p{max-width:355px;font-size:.92rem;color:var(--text-soft);line-height:1.8;margin:0}.process-section{background:#fff}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0 2.2rem}.steps-grid article{position:relat