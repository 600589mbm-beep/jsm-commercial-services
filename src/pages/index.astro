---
import Base from '../layouts/Base.astro';
import { BUSINESS, url } from '../config';
import { SERVICES } from '../data/services';
import { INDUSTRIES } from '../data/industries';
import { LOCATIONS } from '../data/locations';
import { TESTIMONIALS } from '../data/testimonials';
const featured = SERVICES.filter(s => ['janitorial-services','office-cleaning','day-porter-services','floor-care','medical-office-cleaning','industrial-warehouse-cleaning'].includes(s.slug));
const faqs = [
  {q:'How do I request a commercial cleaning walkthrough?',a:'Open the walkthrough form, describe your building, choose your cleaning frequency and suggest a date and time window. JSM will contact you to confirm availability. Selecting a date is a request, not a confirmed appointment.'},
  {q:'Can I request cleaning from one to seven days per week?',a:'Yes. The request form lets you specify one through seven days per week, choose preferred weekdays and explain your preferred cleaning hours. JSM reviews the scope and confirms a service schedule in the proposal. One-time and custom schedules can also be requested.'},
  {q:'Can I share an existing RFP or building scope?',a:'Yes. Add a document link or paste your RFP requirements in the walkthrough form. File attachments can be emailed separately to JSM with your building name and address. Include the bid deadline and any site-visit requirements.'},
  {q:'What determines the price of commercial cleaning?',a:'Your building type, cleanable square footage, traffic, restrooms, floor surfaces, cleaning frequency and required tasks all affect the scope. A walkthrough helps establish the requirements before JSM prepares a written proposal.'},
];
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Base title="Commercial Cleaning & Janitorial in the Twin Cities | JSM" description="Commercial cleaning for Twin Cities offices, retail, clinics and managed properties. Set your cleaning frequency and request a free JSM building walkthrough.">
  <section class="home-hero"><div class="container hero-layout"><div class="hero-copy"><p class="eyebrow">TWIN CITIES COMMERCIAL CLEANING</p><h1>A cleaner building.<br /><em>A simpler workday.</em></h1><p class="hero-description">Commercial cleaning and janitorial services built around your property, your people and your schedule. One local team. A clear, written scope.</p><div class="hero-actions"><a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough <span aria-hidden="true">↗</span></a><a class="text-link" href={url('/commercial-cleaning-twin-cities')}>Explore cleaning options →</a></div><p class="hero-caption">Tell us your building type. Choose your cleaning days. Share your RFP.</p><div class="hero-proof"><span>Owner-led service</span><span>Twin Cities coverage</span><span>Written cleaning scopes</span></div></div>
  <aside class="plan-panel" aria-label="Illustration of a building-specific cleaning plan"><div class="panel-top"><span class="panel-mark">JSM</span><span>FACILITY CARE, SIMPLIFIED</span></div><div class="building-illustration" aria-hidden="true"><svg viewBox="0 0 480 260" width="480" height="260" fill="none"><path d="M45 207 241 118 433 207 238 255Z" fill="#d8e9e2"/><path d="m94 196 132 44V89L94 48Z" fill="#153d4a"/><path d="m226 89 143-52v151l-143 52Z" fill="#275763"/><path d="M94 48 237 8l132 29-143 52Z" fill="#b7d8cb"/><path d="m114 78 27 9v28l-27-9Zm43 14 27 9v28l-27-9Zm-43 33 27 9v28l-27-9Zm43 14 27 9v28l-27-9Zm-43 33 27 9v28l-27-9Zm43 14 27 9v28l-27-9Z" fill="#91bdb0"/><path d="m249 98 32-12v28l-32 12Zm53-19 32-12v28l-32 12Zm-53 65 32-12v28l-32 12Zm53-19 32-12v28l-32 12Zm-53 65 32-12v28l-32 12Z" fill="#d8e9df"/><path d="m302 171 32-12v41l-32 12Z" fill="#0f2d3b"/><path d="M378 197v-53m-15 18 15 11 15-22" stroke="#317164" stroke-width="7" stroke-linecap="round"/><circle cx="378" cy="139" r="21" fill="#94c4a7"/><path d="M66 185v-32" stroke="#317164" stroke-width="6"/><circle cx="66" cy="141" r="18" fill="#accdb1"/></svg></div><div class="plan-bottom"><p class="plan-label">YOUR PLAN STARTS HERE</p><h2>One building.<br />Every detail considered.</h2><div class="plan-row"><span>01 · Your property</span><strong>Type, size & spaces</strong></div><div class="plan-row"><span>02 · Your schedule</span><strong>1–7 days per week</strong></div><div class="plan-row"><span>03 · Your priorities</span><strong>Scope, RFP & walkthrough</strong></div><a href={url('/quote')}>Build your request <span aria-hidden="true">→</span></a></div></aside></div></section>
  <section class="intro-strip"><div class="container"><span>BUILT FOR THE WAY YOUR PROPERTY WORKS</span><p>Offices <b>·</b> Managed properties <b>·</b> Retail <b>·</b> Clinics <b>·</b> Warehouses</p></div></section>
  <section class="home-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THE RIGHT START</p><h2>Less back-and-forth.<br />A better building walkthrough.</h2></div><p>Give us the details once. We will use them to prepare for your site visit and discuss a cleaning plan that fits.</p></div><div class="steps-grid"><article><span class="step-number">01</span><h3>Describe your building</h3><p>Tell us the property type, address, cleanable square footage and spaces that need attention.</p></article><article><span class="step-number">02</span><h3>Choose your cleaning days</h3><p>Specify exactly how many days per week you need cleaned, preferred weekdays and cleaning hours.</p></article><article><span class="step-number">03</span><h3>Request a visit. Share the scope.</h3><p>Pick a preferred walkthrough date and include your RFP link, requirements or proposal deadline.</p></article></div><a class="inline-action" href={url('/quote')}>Start your free walkthrough request →</a></div></section>
  <section class="home-section soft-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">COMMERCIAL CLEANING SERVICES</p><h2>Daily essentials.<br />Specialty care when you need it.</h2></div><a class="inline-action" href={url('/services')}>View all services →</a></div><div class="services-grid">{featured.map((s,i)=><a class="service-tile" href={url(`/services/${s.slug}`)}><span class="tile-number">0{i+1}<span aria-hidden="true">↗</span></span><h3>{s.name}</h3><p>{s.short}</p><span class="tile-more">Explore service →</span></a>)}</div></div></section>
  <section class="home-section"><div class="container schedule-layout"><div><p class="eyebrow">YOUR FREQUENCY. NOT A GUESS.</p><h2>How many days<br />does your building need?</h2><p class="section-lead">Request cleaning one through seven days per week, a one-time project or a custom schedule. Your proposal should spell out both the tasks and how often they happen.</p><p>Share your preferred days and cleaning window. We will review traffic, restrooms, floor surfaces and operating hours during the walkthrough before confirming the plan.</p><a class="inline-action" href={url('/commercial-cleaning-twin-cities')}>Compare building types and cleaning schedules →</a></div><div class="schedule-panel"><span class="eyebrow">ILLUSTRATIVE WEEKLY SCHEDULE</span><h3>A plan you can see at a glance.</h3><div class="sample-week">{['M','T','W','T','F','S','S'].map((day,i)=><span class:list={[i<5?'selected':'']}><small>{day}</small><strong>{i<5?'✓':'—'}</strong></span>)}</div><div class="scope-line"><span>Cleaning visits</span><strong>5 days / week</strong></div><div class="scope-line"><span>Timing</span><strong>After business hours</strong></div><div class="scope-line"><span>Scope</span><strong>Defined by your building</strong></div><p>Example only. Not a booking calendar or a guaranteed service slot.</p><a class="btn btn-primary" href={url('/quote')}>Choose Your Cleaning Schedule →</a></div></div></section>
  <section class="rfp-banner"><div class="container rfp-layout"><div><p class="eyebrow">FOR PROPERTY MANAGERS & PROCUREMENT TEAMS</p><h2>Your building documentation<br />belongs with your request.</h2><p>Already have an RFP, floor plan, current cleaning scope or location schedule? Add a link or paste your requirements in the walkthrough form. Email attachments separately with the building name and address.</p><a class="btn btn-primary" href={url('/quote')}>Start a Walkthrough & RFP Request →</a></div><div class="document-stack"><div><span>01</span><strong>Building details & floor plans</strong></div><div><span>02</span><strong>Tasks & cleaning frequencies</strong></div><div><span>03</span><strong>Bid instructions & deadlines</strong></div><p>Keep confidential documents access-restricted. Do not share keys, access codes or personal information.</p></div></div></section>
  <section class="home-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">FACILITY-SPECIFIC PLANNING</p><h2>Different buildings.<br />Different cleaning priorities.</h2></div><a class="inline-action" href={url('/industries')}>Explore all facility types →</a></div><div class="industry-links">{INDUSTRIES.map(i=><a href={url(`/industries/${i.slug}`)}>{i.name}<span aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="home-section soft-section"><div class="container resource-layout"><div><p class="eyebrow">MAKE A MORE INFORMED DECISION</p><h2>A clear scope makes<br />a stronger comparison.</h2><p>Review the operating approach, prepare your RFP, or plan the switch from an existing provider.</p></div><div class="resource-links"><a href={url('/facility-care-program')}><span>01</span><div><strong>The JSM Facility Care Program</strong><small>Understand scope, startup and quality checks</small></div>→</a><a href={url('/switching-cleaning-companies')}><span>02</span><div><strong>Switching cleaning providers</strong><small>Plan a practical handover for your property</small></div>→</a><a href={url('/resources/templates')}><span>03</span><div><strong>RFP templates & vendor scorecard</strong><small>Compare proposals using the same requirements</small></div>→</a><a href={url('/janitorial-contracts')}><span>04</span><div><strong>Commercial janitorial contracts</strong><small>Explore recurring service and written scopes</small></div>→</a></div></div></section>
  {TESTIMONIALS.length>0 && <section class="home-section"><div class="container"><h2>From JSM clients</h2><div class="services-grid">{TESTIMONIALS.map(t=><blockquote class="service-tile"><p>“{t.quote}”</p><footer>{t.name}, {t.company}</footer></blockquote>)}</div></div></section>}
  <section class="home-section"><div class="container faq-layout"><div><p class="eyebrow">BEFORE YOUR WALKTHROUGH</p><h2>A few helpful answers.</h2><p>Have a building-specific question?<br /><a href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a></p></div><div>{faqs.map(f=><details class="home-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
  <section class="coverage-section"><div class="container"><p class="eyebrow">LOCAL SERVICE. TWIN CITIES REACH.</p><h2>Commercial cleaning across the metro.</h2><p>From Apple Valley and Eagan to Minneapolis, St. Paul, Bloomington and Edina. Share your address so we can review your building’s service needs.</p><div class="city-links">{LOCATIONS.slice(0,8).map(l=><a href={url(`/locations/${l.slug}`)}>{l.city || l.name}</a>)}</div><a class="inline-action" href={url('/locations')}>View the full service area →</a></div></section>
  <section class="closing-section"><div class="container"><div><p class="eyebrow">LET’S START WITH YOUR BUILDING</p><h2>Tell us what clean<br />needs to look like.</h2></div><div><a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough →</a><p>Preferred dates are confirmed by JSM.<br />{BUSINESS.responsePromise}</p></div></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
<style>
  .eyebrow{font-size:.7rem;font-weight:800;letter-spacing:.14em;color:#096b5e;margin:0 0 1rem}.home-hero{background:#f5f8f3;padding:4.5rem 0 4rem;overflow:hidden}.hero-layout{display:grid;grid-template-columns:1.2fr 1fr;gap:4rem;align-items:center}.hero-copy h1{font-size:clamp(2.8rem,5.1vw,4.5rem);letter-spacing:-.055em;line-height:1.04;margin-bottom:1.5rem;color:#102c40}.hero-copy h1 em{font-style:normal;color:#087266}.hero-description{font-size:1.08rem;max-width:530px;line-height:1.8;color:#49616f}.hero-actions{display:flex;align-items:flex-start;gap:1rem;flex-direction:column;margin:1.8rem 0 1rem}.home-hero .btn-primary,.schedule-panel .btn-primary,.rfp-banner .btn-primary,.closing-section .btn-primary{background:#096e64;box-shadow:none;border-radius:.6rem}.hero-actions .btn-primary{display:flex;gap:1rem;align-items:center}.text-link,.inline-action{font-weight:800;color:#075f54;font-size:.9rem}.hero-caption{font-size:.78rem;color:#526b77;max-width:400px}.hero-proof{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;font-size:.73rem;color:#425d65;margin-top:1.9rem}.hero-proof span:before{content:'✓';color:#096e64;margin-right:.35rem}.plan-panel{background:#fff;border:1px solid #d6e4dc;border-radius:1.3rem;box-shadow:0 24px 60px #23483c12;overflow:hidden;transform:rotate(1deg)}.panel-top{padding:1.15rem 1.5rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e1eae4;font-size:.58rem;letter-spacing:.1em;color:#476771;font-weight:800}.panel-mark{padding:.4rem .55rem;color:#fff;background:#102c40;border-radius:.3rem;font-size:.78rem;letter-spacing:.04em}.building-illustration{background:#edf4eb;padding:1rem 1.5rem .2rem}.building-illustration svg{display:block;width:100%;height:auto;max-height:220px}.plan-bottom{padding:1.5rem 1.75rem}.plan-label{font-size:.62rem;letter-spacing:.13em;color:#4e7564;font-weight:800;margin-bottom:.6rem}.plan-bottom h2{font-size:1.65rem;line-height:1.15;letter-spacing:-.035em;margin-bottom:1rem}.plan-row{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #e2ebe5;padding:.7rem 0;font-size:.73rem}.plan-row>span{color:#61786f}.plan-row strong{font-weight:700}.plan-bottom>a{display:flex;justify-content:space-between;background:#e9f4eb;color:#0a6254;padding:.85rem 1rem;border-radius:.45rem;text-decoration:none;font-size:.84rem;font-weight:800;margin-top:.4rem}.intro-strip{border-top:1px solid #dce6df;border-bottom:1px solid #dce6df;background:#fff;padding:1.5rem 0}.intro-strip .container{display:flex;justify-content:space-between;align-items:center;gap:1.5rem}.intro-strip span{font-size:.58rem;letter-spacing:.13em;font-weight:800;color:#5f756c}.intro-strip p{font-size:.8rem;margin:0;color:#304b55}.intro-strip b{font-weight:400;color:#91a69c;margin:0 .7rem}.home-section{padding:5rem 0}.section-heading{display:flex;justify-content:space-between;gap:3rem;align-items:end;margin-bottom:2.4rem}.section-heading h2,.schedule-layout h2,.resource-layout h2,.faq-layout h2,.rfp-layout h2{font-size:clamp(1.8rem,3.1vw,2.7rem);letter-spacing:-.04em;line-height:1.12}.section-heading>p{max-width:340px;font-size:.94rem;color:#526977;line-height:1.8;margin:0}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin:2rem 0}.steps-grid article{border-top:1px solid #cbded4;padding-top:1.2rem}.step-number{display:inline-block;font-size:.72rem;font-weight:800;padding:.6rem;background:#e7f1e9;border-radius:.5rem;color:#116a56;margin-bottom:1.3rem}.steps-grid h3{font-size:1.12rem}.steps-grid p,.service-tile p,.schedule-layout p,.resource-layout p,.faq-layout>div>p{color:#526977;font-size:.9rem;line-height:1.8}.soft-section{background:#f3f6f5}.services-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.service-tile{display:block;border:1px solid #dce5e3;background:#fff;border-radius:.8rem;padding:1.7rem;text-decoration:none;transition:border-color .2s,transform .2s}.service-tile:hover{border-color:#84aa98;transform:translateY(-3px)}.tile-number{display:flex;justify-content:space-between;color:#538073;font-size:.75rem;font-weight:800;margin-bottom:1.4rem}.tile-number>span{font-size:1.2rem}.service-tile h3{font-size:1.15rem;line-height:1.25}.tile-more{color:#116554;font-weight:700;font-size:.78rem}.schedule-layout{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.schedule-layout .section-lead{font-size:1rem}.schedule-panel{padding:2rem;background:#f6f8f1;border:1px solid #d7e1cc;border-radius:1rem}.schedule-panel h3{margin-top:1rem;font-size:1.25rem}.sample-week{display:grid;grid-template-columns:repeat(7,1fr);gap:.35rem;margin:1.4rem 0}.sample-week>span{display:grid;text-align:center;gap:.5rem;padding:.7rem .1rem;border:1px solid #dce5d8;border-radius:.5rem;color:#6b8176}.sample-week .selected{background:#e0edde;color:#175e49;border-color:#b2ceb4}.sample-week small{font-size:.67rem}.sample-week strong{font-size:.95rem}.scope-line{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-top:1px solid #dce5d8;font-size:.78rem}.scope-line span{color:#526b60}.scope-line strong{text-align:right;font-weight:700}.schedule-panel p{font-size:.71rem;margin:.7rem 0 1.3rem}.schedule-panel .btn{display:block;text-align:center;padding:.8rem .5rem;font-size:.83rem}.rfp-banner{background:#102c40;color:#fff;padding:4.5rem 0}.rfp-layout{display:grid;grid-template-columns:1.3fr 1fr;gap:4rem;align-items:center}.rfp-layout .eyebrow{color:#a0d7bf}.rfp-layout h2{color:#fff}.rfp-layout p{color:#bed0d8;font-size:.93rem;line-height:1.8}.document-stack{background:#ffffff07;border:1px solid #ffffff18;border-radius:.9rem;padding:1.6rem}.document-stack>div{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid #ffffff16;font-size:.82rem}.document-stack>div>span{font-size:.7rem;color:#95ceb5}.document-stack>div>strong{font-weight:600}.document-stack p{font-size:.73rem;margin:1.2rem 0 0}.industry-links{display:grid;grid-template-columns:repeat(2,1fr);gap:0 2rem}.industry-links a{display:flex;justify-content:space-between;gap:1rem;padding:1.1rem 0;border-bottom:1px solid #dce7e1;text-decoration:none;font-size:.89rem;color:#244c51;font-weight:700}.resource-layout{display:grid;grid-template-columns:1fr 1.25fr;gap:5rem}.resource-links a{display:flex;gap:1rem;align-items:center;border-bottom:1px solid #d7e3dd;padding:1rem 0;text-decoration:none;color:#174b49}.resource-links a>span{font-size:.7rem;color:#739488}.resource-links div{flex:1}.resource-links strong{display:block;font-size:.91rem}.resource-links small{color:#536e72;font-size:.77rem}.faq-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem}.home-faq{border-bottom:1px solid #d8e5dd;padding:1.15rem 0}.home-faq summary{font-size:.92rem;font-weight:700;color:#143d48;cursor:pointer}.home-faq p{font-size:.88rem;color:#4d6972;line-height:1.8;margin:1rem 0 0}.coverage-section{background:#eff4ef;padding:3.5rem 0}.coverage-section h2{font-size:2rem;letter-spacing:-.04em}.coverage-section p:not(.eyebrow){color:#526977;font-size:.9rem;max-width:650px}.city-links{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.5rem 0}.city-links a{border:1px solid #ccdcd1;border-radius:2rem;padding:.4rem .8rem;text-decoration:none;color:#315e53;font-size:.8rem;background:#fff}.closing-section{padding:4rem 0}.closing-section>.container{display:flex;justify-content:space-between;align-items:center;gap:2rem}.closing-section h2{font-size:2.5rem;letter-spacing:-.045em}.closing-section p:not(.eyebrow){font-size:.8rem;color:#58717a;margin:1rem 0 0}.home-faq summary:focus-visible,.inline-action:focus-visible,.service-tile:focus-visible{outline:3px solid #128078;outline-offset:4px}
  @media(max-width:950px){.hero-layout{gap:2rem}.hero-copy h1{font-size:3.3rem}.plan-row{font-size:.68rem}.intro-strip .container{display:block}.intro-strip p{margin-top:.7rem}.schedule-layout,.rfp-layout,.resource-layout,.faq-layout{gap:2.5rem}.services-grid{grid-template-columns:repeat(2,1fr)}.section-heading{gap:2rem}.panel-top{padding:1rem}.plan-bottom{padding:1.3rem}}
  @media(max-width:700px){.home-hero{padding:2.7rem 0}.hero-layout,.schedule-layout,.rfp-layout,.resource-layout,.faq-layout{grid-template-columns:1fr}.hero-copy h1{font-size:clamp(2.7rem,9vw,3.7rem)}.hero-description{font-size:1rem}.hero-actions .btn{font-size:.9rem;width:100%;justify-content:space-between}.plan-panel{transform:none;max-width:460px;width:100%;margin:.8rem auto 0}.building-illustration svg{max-height:165px}.hero-proof{margin-top:1.4rem}.home-section{padding:3.2rem 0}.section-heading{display:block}.section-heading>p{max-width:none;margin-top:1rem}.section-heading>.inline-action{display:inline-block;margin-top:.8rem}.steps-grid{grid-template-columns:1fr;gap:1rem}.steps-grid article{padding-top:.9rem}.step-number{margin-bottom:.7rem}.services-grid,.industry-links{grid-template-columns:1fr}.service-tile{padding:1.4rem}.tile-number{margin-bottom:.8rem}.schedule-panel{padding:1.3rem}.rfp-banner{padding:3rem 0}.intro-strip p{line-height:2}.intro-strip b{margin:0 .35rem}.closing-section>.container{display:block}.closing-section h2{font-size:2.1rem}.closing-section .btn{margin-top:1.3rem}.resource-layout,.faq-layout{gap:1.5rem}}
  @media(prefers-reduced-motion:reduce){.service-tile{transition:none}.service-tile:hover{transform:none}}
</style>
