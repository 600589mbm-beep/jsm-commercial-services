---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import TrustBar from '../components/TrustBar.astro';
import { BUSINESS, url } from '../config';
import { SERVICES, SERVICE_ICONS } from '../data/services';
import { LOCATIONS } from '../data/locations';
import { TESTIMONIALS } from '../data/testimonials';

// Targets real search queries from Search Console / GBP insights
// (e.g. "cleaning service apple valley mn", "janitorial contracts near me").
const FAQS = [
  {
    q: 'Do you offer janitorial contracts in the Twin Cities?',
    a: `Yes — we provide contract janitorial services across the ${BUSINESS.serviceArea}, with documented scopes of work, trained crews, and supervisor inspections. Unlike most janitorial contracts, ours are month-to-month: no long-term lock-in.`,
  },
  {
    q: 'What areas does JSM Commercial Services serve?',
    a: `We're headquartered in Apple Valley, MN and serve 43 cities across the metro — including Minneapolis, St. Paul, Bloomington, Eagan, Burnsville, Eden Prairie, and Lakeville.`,
  },
  {
    q: 'How much does commercial cleaning cost?',
    a: 'Pricing depends on square footage, cleaning frequency, and scope, so we quote from a free on-site walkthrough rather than guessing. Most offices land on a flat monthly rate. The walkthrough and written quote are free with no obligation.',
  },
  {
    q: 'Are your cleaners insured and background-checked?',
    a: 'Yes. Every crew member is background-checked, trained, and uniformed, and we carry general liability and workers’ compensation coverage. We can name your company as additionally insured on request.',
  },
  {
    q: 'What types of facilities do you clean?',
    a: 'Offices, medical and dental clinics, retail, schools, warehouses, and industrial facilities — plus specialty work like floor stripping and waxing, carpet cleaning, post-construction cleanup, and disinfection.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title={`Commercial Cleaning & Janitorial — Twin Cities, MN | Free Quote in 24 Hrs — JSM`}
  description={`JSM provides commercial cleaning & janitorial across the Twin Cities from Apple Valley. Free on-site walkthrough and written quote within 24 hours.`}
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="blob blob-a" aria-hidden="true"></div>
    <div class="blob blob-b" aria-hidden="true"></div>
    <div class="blob blob-c" aria-hidden="true"></div>
    <span class="spark" style="top: 18%; left: 12%; --tw: 3.2s" aria-hidden="true">✦</span>
    <span class="spark" style="top: 32%; right: 14%; --tw: 4.1s" aria-hidden="true">✦</span>
    <span class="spark" style="bottom: 24%; left: 38%; --tw: 5s" aria-hidden="true">✦</span>
    <span class="spark" style="top: 12%; right: 38%; --tw: 3.7s" aria-hidden="true">✦</span>
    <div class="container hero-inner">
      <p class="kicker">★ Apple Valley · Minneapolis · St. Paul & 40+ metro cities</p>
      <h1>
        <span class="line" style="--d: 0.05s">Commercial Cleaning &amp; Janitorial</span>
        <span class="line" style="--d: 0.18s">for the Twin Cities Metro.</span>
        <span class="line accent-line" style="--d: 0.31s"><span class="accent">Guaranteed.</span></span>
      </h1>
      <p class="sub" style="--d: 0.45s">
        Offices, medical facilities, warehouses, and everything in between — cleaned on schedule,
        every time, by bonded and background-checked crews. If a visit misses the mark, we re-clean
        it free.
      </p>
      <div class="buttons" style="--d: 0.58s">
        <a class="btn btn-primary" href={url('/quote')}>Get My Free Quote</a>
        <a class="btn btn-outline" href={BUSINESS.phoneHref}>Call Now — {BUSINESS.phone}</a>
      </div>
      <div class="trust-wrap" style="--d: 0.7s">
        <TrustBar />
      </div>
      {BUSINESS.showStats && (
        <div class="stats">
          <div><strong>{BUSINESS.stats.facilitiesServed}</strong><span>Facilities served</span></div>
          <div><strong>{BUSINESS.stats.yearsInBusiness}</strong><span>Years in business</span></div>
          <div><strong>24/7</strong><span>Emergency response</span></div>
        </div>
      )}
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <>
          {SERVICES.map((s) => (
            <span>{s.name} <i>✦</i></span>
          ))}
        </>
      ))}
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>How It Works</h2>
        <p>From first call to spotless floors in three steps — no pressure, no lock-in.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <span class="num">1</span>
          <h3>Free Walkthrough</h3>
          <p>We tour your facility, listen to what's been missed before, and map every square foot that matters.</p>
        </div>
        <div class="step-card">
          <span class="num">2</span>
          <h3>Custom Plan & Quote</h3>
          <p>You get a written scope and a clear price — built off your facility, not assumptions. Month-to-month, always.</p>
        </div>
        <div class="step-card">
          <span class="num">3</span>
          <h3>Spotless, Inspected Clean</h3>
          <p>Trained crews follow your checklist; supervisors inspect the work. Miss the mark? We re-clean it free.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>Our Services</h2>
        <p>One vendor for every cleaning need in your building — on a schedule built around your business.</p>
      </div>
      <div class="grid grid-3">
        {SERVICES.map((s) => (
          <div class="card">
            <span class="icon">{SERVICE_ICONS[s.slug]}</span>
            <h3><a href={url(`/services/${s.slug}`)}>{s.name}</a></h3>
            <p>{s.short}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Why Businesses Choose JSM</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3>Reliable, Every Visit</h3>
          <p>Documented checklists, supervisor inspections, and a single point of contact mean the clean you were promised is the clean you get.</p>
        </div>
        <div class="card">
          <h3>Insured & Background-Checked</h3>
          <p>Every team member is trained, uniformed, and background-checked, with full liability and workers' comp coverage behind them.</p>
        </div>
        <div class="card">
          <h3>No Long-Term Contracts</h3>
          <p>Month-to-month agreements. We keep your business by doing great work, not by locking you in.</p>
        </div>
      </div>
    </div>
  </section>

  {TESTIMONIALS.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>What Clients Say</h2>
        </div>
        <div class="grid grid-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="card testimonial">
              <p>“{t.quote}”</p>
              <footer>— {t.name}, {t.company}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>Commercial Cleaning Questions, Answered</h2>
      </div>
      <div class="faq-wrap">
        {FAQS.map((f) => (
          <details class="faq-acc">
            <summary>{f.q}<span class="plus">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Serving the {BUSINESS.serviceArea}</h2>
        <p>
          Local crews across {LOCATIONS.length} metro cities — from {LOCATIONS[0].name} to
          Stillwater — mean fast response and consistent service wherever your facility is.
        </p>
      </div>
      <a class="btn btn-navy" href={url('/locations')}>View All {LOCATIONS.length} Cities →</a>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-dark) 70%);
    color: #fff;
    padding: 5.5rem 0 4.5rem;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .spark {
    position: absolute;
    color: var(--teal-bright);
    font-size: 1.1rem;
    animation: twinkle var(--tw, 4s) ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    pointer-events: none;
    /* parallax uses the separate `translate` property so it composes
       with the transform-based float keyframes */
    transition: translate 0.6s var(--ease-out);
  }
  .blob-a {
    width: 480px;
    height: 480px;
    top: -160px;
    right: -120px;
    background: radial-gradient(circle, rgba(25, 163, 154, 0.55), transparent 65%);
    animation: float-a 11s ease-in-out infinite;
  }
  .blob-b {
    width: 380px;
    height: 380px;
    bottom: -140px;
    left: -100px;
    background: radial-gradient(circle, rgba(31, 111, 178, 0.5), transparent 65%);
    animation: float-b 14s ease-in-out infinite;
  }
  .blob-c {
    width: 260px;
    height: 260px;
    top: 30%;
    left: 55%;
    background: radial-gradient(circle, rgba(46, 230, 200, 0.28), transparent 65%);
    animation: float-a 17s ease-in-out infinite reverse;
  }
  .kicker {
    color: var(--teal-bright);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.82rem;
    animation: fade-up 0.7s var(--ease-out) both;
  }
  .hero h1 { color: #fff; max-width: 820px; }
  .hero h1 .line {
    display: block;
    animation: fade-up 0.8s var(--ease-out) both;
    animation-delay: var(--d);
  }
  .sub, .buttons, .trust-wrap {
    animation: fade-up 0.8s var(--ease-out) both;
    animation-delay: var(--d);
  }
  .sub { color: #c4d3df; font-size: 1.15rem; max-width: 640px; }
  .buttons { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.9rem 0 2.5rem; }
  .stats { display: flex; gap: 2.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .stats div { display: flex; flex-direction: column; }
  .stats strong { font-size: 1.6rem; color: var(--teal); }
  .stats span { color: #c4d3df; font-size: 0.9rem; }
  .faq-wrap { max-width: 800px; }
  .testimonial { margin: 0; }
  .testimonial footer { color: var(--text-soft); font-size: 0.88rem; font-weight: 600; }
</style>

<script>
  // Subtle mouse parallax on the hero blobs (desktop, motion-allowed only)
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (
      !hero ||
      matchMedia('(pointer: coarse)').matches ||
      matchMedia('(prefers-reduced-motion: reduce)').matches
    )
      return;
    const blobs = hero.querySelectorAll<HTMLElement>('.blob');
    const depths = [18, 28, 40];
    hero.addEventListener(
      'pointermove',
      (e) => {
        const r = hero.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5;
        const dy = (e.clientY - r.top) / r.height - 0.5;
        blobs.forEach((b, i) => {
          b.style.translate = `${dx * depths[i]}px ${dy * depths[i]}px`;
        });
      },
      { passive: true }
    );
  });
</script>
