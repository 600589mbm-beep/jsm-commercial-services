---
import Base from '../layouts/Base.astro';
import { BUSINESS, url } from '../config';
const buildings = [
  {name:'Office buildings',href:'/services/office-cleaning',copy:'Identify workstations, private offices, meeting rooms, reception, restrooms and breakrooms. Separate the area to be cleaned from the entire leased square footage, and tell us which spaces are occupied each day.'},
  {name:'Multi-tenant & managed properties',href:'/industries/property-management-cleaning',copy:'Separate landlord common areas from tenant suites. Include lobbies, elevators, corridors, shared restrooms and management offices. For multiple addresses, list a separate scope and weekly schedule for each building.'},
  {name:'Retail & shopping centers',href:'/industries/retail-store-cleaning',copy:'Describe customer entrances, sales floors, fitting rooms, restrooms, back-of-house areas and food-adjacent spaces. Opening hours and customer traffic help define whether work belongs before opening, after closing or during the day.'},
  {name:'Medical & dental offices',href:'/services/medical-office-cleaning',copy:'Distinguish reception, administrative areas, restrooms and clinical rooms. Share your facility’s approved cleaning requirements and identify any specialist work, restricted areas or tasks outside the janitorial scope.'},
  {name:'Warehouses & industrial facilities',href:'/services/industrial-warehouse-cleaning',copy:'Separate warehouse floors, offices, employee amenities and loading areas. Explain shift changes, equipment traffic and restricted zones. A walkthrough helps define what can be cleaned safely within the agreed scope.'},
  {name:'Schools, gyms & other facilities',href:'/industries',copy:'Explain how the building is used, when rooms are occupied, and which areas need extra attention. Classrooms, locker rooms, common spaces and event areas can each require a different task schedule.'},
];
const faqs = [
  {q:'How do I schedule a commercial cleaning walkthrough in the Twin Cities?',a:'Complete the JSM walkthrough request with your building type, address, cleaning frequency and preferred date. Choose a Central Time window or ask JSM to contact you to arrange a visit. JSM must confirm the appointment before the walkthrough is booked.'},
  {q:'Can I specify exactly how many days a week the building needs cleaning?',a:'Yes. Select one through seven days per week in the form and optionally choose the exact weekdays. You can also request a one-time project, a custom or rotating schedule, or help choosing a frequency. The final schedule is confirmed in the proposal.'},
  {q:'Can I submit a janitorial RFP or existing building scope?',a:'Share an HTTPS document link or paste your requirements in the walkthrough form. Email file attachments separately with the building name and address. Include the proposal deadline, required walkthrough details, areas to be cleaned, service frequencies and submission instructions.'},
  {q:'What if I do not know the square footage?',a:'Leave the square-footage field blank and describe the spaces you need cleaned. An estimate is useful when available, but the walkthrough can help clarify the cleanable area and scope before pricing is finalized.'},
  {q:'Can one request cover several buildings?',a:'Yes. Enter the number of locations and add the other addresses, or share a site schedule with your RFP. Specify the building type, size, cleaning days and priorities separately for each address so different sites are not treated as identical.'},
  {q:'Does choosing a date immediately reserve an appointment?',a:'No. Dates and time windows in the form are preferences. JSM reviews the request and contacts you to confirm availability, the meeting time and any check-in instructions.'},
];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'Service',name:'Twin Cities commercial cleaning and janitorial services',serviceType:'Commercial cleaning and janitorial services',provider:{'@id':BUSINESS.website+'/#localbusiness'},areaServed:{'@type':'AdministrativeArea',name:BUSINESS.serviceArea},url:BUSINESS.website+'/commercial-cleaning-twin-cities/',description:'Building-specific commercial cleaning proposals, recurring cleaning schedules and facility walkthrough requests across the Twin Cities metro.'},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:BUSINESS.website+'/'},{'@type':'ListItem',position:2,name:'Twin Cities commercial cleaning',item:BUSINESS.website+'/commercial-cleaning-twin-cities/'}]},
  {'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
]};
---
<Base title="Twin Cities Commercial Cleaning & Building Proposals | JSM" description="Plan commercial cleaning for your Twin Cities building. Compare cleaning frequencies, share an RFP and request a free on-site JSM walkthrough.">
  <section class="guide-hero"><div class="container"><nav aria-label="Breadcrumb"><a href={url('/')}>Home</a> / Twin Cities commercial cleaning</nav><p class="eyebrow">COMMERCIAL CLEANING & JANITORIAL SERVICES</p><h1>Twin Cities commercial cleaning.<br /><span>Planned around your building.</span></h1><p>From offices and retail spaces to managed properties, clinics and warehouses, a useful cleaning proposal starts with the details of your facility—not a generic checklist.</p><div class="guide-actions"><a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough →</a><a href="#cleaning-frequency">Compare cleaning schedules ↓</a></div></div></section>
  <div class="guide-nav"><nav class="container" aria-label="On this page"><a href="#building-types">Building types</a><a href="#cleaning-frequency">Cleaning frequency</a><a href="#scope">Your scope</a><a href="#rfp">RFP requirements</a><a href="#coverage">Service area</a><a href="#questions">Questions</a></nav></div>
  <section class="guide-section" id="building-types"><div class="container"><p class="eyebrow">START WITH THE FACILITY</p><h2>What kind of building do you manage?</h2><p class="guide-lead">The walkthrough request asks for the actual property type, building name, address and cleanable square footage. Add floors, restrooms, daily occupancy and special requirements where available. These details help separate everyday janitorial work from periodic projects and site-specific needs.</p><div class="building-grid">{buildings.map(b=><article><h3>{b.name}</h3><p>{b.copy}</p><a href={url(b.href)}>Explore cleaning services →</a></article>)}</div></div></section>
  <section class="guide-section tinted" id="cleaning-frequency"><div class="container"><p class="eyebrow">MAKE THE FREQUENCY EXPLICIT</p><h2>One, three, five or seven cleaning days per week?</h2><p class="guide-lead">Tell us exactly how many days per week you need service, then select preferred weekdays and a cleaning window. These are starting points for a conversation—not fixed recommendations, published prices or guaranteed availability.</p><div class="frequency-grid"><article><strong>1–2</strong><span>DAYS PER WEEK</span><h3>Lighter-use schedules</h3><p>A frequency to discuss for lower-traffic offices or selected areas. Daily-use restrooms or heavily used shared spaces may need a separate plan.</p></article><article><strong>3–4</strong><span>DAYS PER WEEK</span><h3>More frequent upkeep</h3><p>A starting point when traffic and occupancy vary during the week. Specify which days matter most and which tasks are needed each visit.</p></article><article><strong>5</strong><span>DAYS PER WEEK</span><h3>A business-week routine</h3><p>A schedule to discuss for regularly occupied weekday buildings. Identify after-hours access, opening-time expectations and periodic floor care.</p></article><article><strong>6–7</strong><span>DAYS PER WEEK</span><h3>Weekend-inclusive needs</h3><p>For buildings seeking service across more of the week. Include weekend hours, peak-use days and any need for daytime support.</p></article></div><p>Need multiple visits per day, a rotating calendar or a one-time project? Explain the requirement in the form. A cleaning visit’s frequency is not the same as every task’s frequency: restrooms, carpet extraction, glass and floor restoration should each be addressed in the written scope.</p><a class="inline-action" href={url('/quote')}>Tell JSM your preferred cleaning frequency →</a></div></section>
  <section class="guide-section" id="scope"><div class="container two-col"><div><p class="eyebrow">A CLEARER COMMERCIAL CLEANING PROPOSAL</p><h2>Define what gets cleaned,<br />when and where.</h2><p>A square-footage number alone does not describe a building. The proposal discussion should identify included spaces, excluded work, cleaning windows, supplies, periodic services and the process for raising service concerns.</p><p>JSM’s <a href={url('/facility-care-program')}>Facility Care Program</a> explains the operating approach. For ongoing service, review the <a href={url('/janitorial-contracts')}>commercial janitorial contract information</a>. Organizations replacing a current vendor can also review the <a href={url('/switching-cleaning-companies')}>provider-transition guide</a>.</p></div><aside class="scope-card"><h3>Bring these details to the walkthrough</h3><ul><li>Cleanable area, floors, restrooms and common spaces</li><li>Building hours and preferred cleaning times</li><li>Carpet, hard-floor and other surface types</li><li>Daily, weekly and periodic task expectations</li><li>Current service concerns and priority areas</li><li>Proposal deadline and preferred service start</li></ul><p>Discuss security procedures with the appropriate contact. Do not put alarm codes or passwords into the public request form.</p></aside></div></section>
  <section class="guide-section dark-section" id="rfp"><div class="container two-col"><div><p class="eyebrow">PROCUREMENT & PROPERTY MANAGEMENT</p><h2>Submit a janitorial RFP<br />with the building context.</h2><p>Your RFP may already include the task list, floor plan, service days, insurance requirements and bid instructions. Sharing it with your request helps keep the walkthrough discussion tied to the building’s actual requirements.</p><p>The form accepts document links and pasted requirements. File attachments are emailed separately. Grant document access to <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> rather than making confidential files public.</p><a class="btn btn-primary" href={url('/quote')}>Start a Walkthrough & RFP Request →</a></div><div class="rfp-checklist"><h3>Include with your RFP</h3><ul><li>Property name, address and on-site contact</li><li>Tasks, areas and required service frequency</li><li>Mandatory site-visit instructions, if any</li><li>Bid deadline and proposal delivery instructions</li><li>Contract start date and site-specific requirements</li><li>A separate schedule for each building in a portfolio</li></ul><a href={url('/resources/templates')}>Need a starting point? Explore the RFP templates →</a></div></div></section>
  <section class="guide-section" id="coverage"><div class="container"><p class="eyebrow">TWIN CITIES SERVICE AREA</p><h2>Local commercial cleaning across the metro.</h2><p class="guide-lead">JSM serves the Minneapolis–St. Paul metro. Explore local service information for <a href={url('/locations/minneapolis')}>Minneapolis</a>, <a href={url('/locations/st-paul')}>St. Paul</a>, <a href={url('/locations/apple-valley')}>Apple Valley</a>, <a href={url('/locations/eagan')}>Eagan</a>, <a href={url('/locations/bloomington')}>Bloomington</a>, <a href={url('/locations/edina')}>Edina</a>, <a href={url('/locations/burnsville')}>Burnsville</a> and <a href={url('/locations/eden-prairie')}>Eden Prairie</a>. Include your exact building address in the request so JSM can review location and scheduling needs.</p><a class="inline-action" href={url('/locations')}>See the complete service area →</a></div></section>
  <section class="guide-section tinted" id="questions"><div class="container"><p class="eyebrow">WALKTHROUGHS, CLEANING SCHEDULES & RFPs</p><h2>Frequently asked questions</h2><div class="guide-faqs">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
  <section class="guide-section"><div class="container final-call"><div><p class="eyebrow">YOUR NEXT STEP</p><h2>Let’s look at your building.</h2><p>Suggest a date. Set your cleaning frequency. Share your scope.<br />JSM will contact you to confirm the walkthrough.</p></div><a class="btn btn-primary" href={url('/quote')}>Request a Free Walkthrough →</a></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
<style>
.eyebrow{font-size:.7rem;letter-spacing:.14em;font-weight:800;color:#0a6d62}.guide-hero{background:#102c40;color:#fff;padding:2rem 0 4rem}.guide-hero nav{font-size:.78rem;color:#c1d4dc;margin-bottom:2.5rem}.guide-hero nav a{color:#d1e1e7}.guide-hero .eyebrow{color:#a3d9c3}.guide-hero h1{color:#fff;font-size:clamp(2.1rem,4.8vw,3.8rem);line-height:1.1;letter-spacing:-.04em}.guide-hero h1 span{color:#b0ddc4}.guide-hero p:not(.eyebrow){max-width:730px;line-height:1.8;color:#c3d6de;font-size:1.02rem}.guide-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1.2rem;margin-top:1.8rem}.guide-actions>a:not(.btn){color:#bee6d5;font-size:.85rem;font-weight:700}.btn-primary{background:#096e64;box-shadow:none}.guide-nav{border-bottom:1px solid #d7e3de;background:#f4f7f4}.guide-nav nav{display:flex;flex-wrap:wrap;gap:.5rem 1.8rem;padding-top:1rem;padding-bottom:1rem}.guide-nav a{font-size:.8rem;color:#2b5c53;font-weight:700}.guide-section{padding:4.5rem 0;scroll-margin-top:110px}.guide-section h2{font-size:clamp(1.8rem,3.3vw,2.65rem);letter-spacing:-.035em;line-height:1.15}.guide-section p{font-size:.94rem;color:#4e6974;line-height:1.85}.guide-lead{max-width:880px}.building-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2rem}.building-grid article{border:1px solid #d8e5df;padding:1.5rem;border-radius:.8rem}.building-grid h3{font-size:1.08rem;line-height:1.3}.building-grid p{font-size:.87rem}.building-grid a,.inline-action{font-size:.84rem;font-weight:800;color:#09665c}.tinted{background:#f1f6f2}.frequency-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:2rem 0}.frequency-grid article{background:#fff;border:1px solid #d2e0d7;border-radius:.8rem;padding:1.4rem}.frequency-grid strong{display:block;color:#0b6b5b;font-size:2.6rem;line-height:1.1;font-weight:800}.frequency-grid article>span{display:block;font-size:.6rem;letter-spacing:.1em;color:#5c7c6d;margin:.6rem 0 1.3rem}.frequency-grid h3{font-size:1rem;line-height:1.3}.frequency-grid p{font-size:.83rem;margin-bottom:0}.two-col{display:grid;grid-template-columns:1.2fr 1fr;gap:4rem;align-items:start}.scope-card{padding:1.8rem;background:#f5f7f0;border:1px solid #dbe4cf;border-radius:.9rem}.scope-card h3{font-size:1.1rem}.scope-card ul,.rfp-checklist ul{padding-left:1.2rem;font-size:.88rem;line-height:1.8}.scope-card li,.rfp-checklist li{padding:.3rem 0}.scope-card p{font-size:.78rem;margin-bottom:0}.dark-section{background:#102c40;color:#fff}.dark-section .eyebrow{color:#a0d8c1}.dark-section h2,.dark-section h3{color:#fff}.dark-section p{color:#c0d4dd}.dark-section a:not(.btn){color:#aee2cc;overflow-wrap:anywhere}.rfp-checklist{padding:1.8rem;background:#ffffff08;border:1px solid #ffffff20;border-radius:.9rem;color:#d2e1e7}.rfp-checklist>a{font-size:.83rem;font-weight:700}.guide-faqs{max-width:900px;margin-top:1.5rem}.guide-faqs details{border-bottom:1px solid #ccddd2;padding:1.2rem 0}.guide-faqs summary{font-weight:700;font-size:.94rem;cursor:pointer;color:#143f46}.guide-faqs p{font-size:.88rem;margin:1rem 0 0}.final-call{display:flex;justify-content:space-between;align-items:center;gap:2rem}.final-call p{margin-bottom:0}.guide-nav a:focus-visible,.guide-faqs summary:focus-visible{outline:3px solid #128078;outline-offset:4px}
@media(max-width:950px){.building-grid{grid-template-columns:repeat(2,1fr)}.frequency-grid{grid-template-columns:repeat(2,1fr)}.two-col{gap:2rem}}@media(max-width:650px){.guide-hero{padding-bottom:3rem}.guide-section{padding:3rem 0}.building-grid,.two-col{grid-template-columns:1fr}.frequency-grid{gap:.7rem}.frequency-grid article{padding:1rem}.frequency-grid h3{font-size:.95rem}.guide-nav nav{gap:.5rem 1rem}.guide-actions{align-items:start;flex-direction:column}.guide-actions .btn{font-size:.87rem}.final-call{display:block}.final-call>.btn{margin-top:1.5rem}.scope-card,.rfp-checklist{padding:1.3rem}}
</style>
