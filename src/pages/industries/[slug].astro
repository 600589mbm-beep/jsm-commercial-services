---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../config';
import { INDUSTRIES } from '../../data/industries';
import { SERVICES } from '../../data/services';
import { COST_GUIDES } from '../../data/costGuides';
import { breadcrumbList } from '../../lib/breadcrumbs';

export function getStaticPaths() {
  return INDUSTRIES.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const related = SERVICES.filter((service) => industry.relatedServices.includes(service.slug));
const guide = industry.costGuide ? COST_GUIDES.find((costGuide) => costGuide.slug === industry.costGuide) : null;
const canonical = new URL(`/industries/${industry.slug}/`, BUSINESS.website).href;
const businessId = `${new URL('/', BUSINESS.website).href}#localbusiness`;

const aliases: Record<string, string[]> = {
  'gym-fitness-cleaning': ['Fitness center & gym cleaning', 'Gym cleaning service'],
  'school-daycare-cleaning': ['School & campus cleaning', 'School cleaning service'],
  'property-management-cleaning': ['Multi-tenant cleaning', 'Commercial common-area cleaning'],
  'retail-store-cleaning': ['Retail cleaning service', 'Shopping center cleaning'],
  'church-cleaning': ['Worship facility cleaning'],
  'restaurant-cleaning': ['Restaurant cleaning service'],
  'car-dealership-cleaning': ['Showroom cleaning service'],
  'bank-credit-union-cleaning': ['Bank cleaning service'],
};
const industryAliases = aliases[industry.slug] ?? [];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: industry.name,
  ...(industryAliases.length ? { alternateName: industryAliases, serviceType: industryAliases } : { serviceType: industry.name }),
  description: industry.short,
  url: canonical,
  areaServed: { '@type': 'AdministrativeArea', name: BUSINESS.serviceArea },
  provider: { '@id': businessId },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: industry.faq.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = breadcrumbList(BUSINESS.website, [
  ['Home', '/'],
  ['Industries', '/industries'],
  [industry.name, null],
]);
---

<Base
  title={`${industry.name} | Twin Cities, MN | ${BUSINESS.shortName}`}
  description={`${industry.name} across the Twin Cities with a facility-specific written scope, background-checked crews, supervisor inspections, and a free walkthrough from JSM.`}
>
  <section class="industry-hero">
    <div class="container hero-layout">
      <div>
        <nav class="crumbs dark">
          <a href={url('/')}>Home</a> / <a href={url('/industries')}>Industries</a> / {industry.name}
        </nav>
        <p class="eyebrow">Facility-specific commercial cleaning</p>
        <h1>{industry.name}</h1>
        <p class="lead">
          <strong>{BUSINESS.name}</strong> provides {industry.name.toLowerCase()} throughout the
          {BUSINESS.serviceArea} using a written scope, schedule, and quality-control plan built around
          how the {industry.noun} operates.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={url('/quote')}>Request a Free Facility Walkthrough</a>
          <a class="btn btn-outline" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
        </div>
      </div>
      <aside class="industry-card">
        <p class="card-label">Facility focus</p>
        <p>{industry.short}</p>
        {industryAliases.length > 0 && <small>Related service names: {industryAliases.join(' · ')}</small>}
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p>{industry.description}</p>
        <h2>Why {industry.name} Requires a Specific Scope</h2>
        <ul class="checklist">
          {industry.painPoints.map((point) => <li>{point}</li>)}
        </ul>
        <h2>What Can Be Included</h2>
        <ul class="checklist">
          {industry.included.map((item) => <li>{item}</li>)}
        </ul>
        <h2>Frequently Asked Questions</h2>
        {industry.faq.map((faq) => (
          <details class="faq-acc">
            <summary>{faq.q}<span class="plus">+</span></summary>
            <p>{faq.a}</p>
          </details>
        ))}
        <h2>Related Services{guide && ' & Pricing'}</h2>
        <ul class="checklist">
          {related.map((service) => (
            <li><a href={url(`/services/${service.slug}`)}>{service.name}</a> — {service.short}</li>
          ))}
          {guide && (
            <li><a href={url(`/resources/${guide.slug}`)}>{guide.title}</a> — review common cost drivers and planning considerations.</li>
          )}
        </ul>
      </div>
      <aside class="card quote-card">
        <h2>Request a Facility-Specific Quote</h2>
        <p>Tell JSM about your {industry.noun}. {BUSINESS.responsePromise}</p>
        <QuoteForm variant="cleaning" />
      </aside>
    </div>
  </section>

  <CTA heading={`Need a cleaning plan for your ${industry.noun}?`} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .industry-hero { padding: 4.9rem 0; color: #fff; background: linear-gradient(145deg, #071a2a, var(--navy) 65%, #174654); }
  .hero-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: 4rem; align-items: center; }
  .crumbs.dark, .crumbs.dark a { color: #c5d5e0; }
  .eyebrow { color: var(--teal-bright); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  h1 { color: #fff; font-size: clamp(2.5rem, 5vw, 4.15rem); }
  .lead { color: #c8d7e3; font-size: 1.08rem; }
  .lead strong { color: #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.7rem; }
  .industry-card { padding: 1.9rem; border: 1px solid rgba(255,255,255,.16); border-radius: 18px; background: rgba(255,255,255,.09); }
  .card-label { color: var(--teal-bright); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .industry-card p:not(.card-label) { color: #d8e5ec; }
  .industry-card small { color: #a9bcc9; line-height: 1.5; }
  .split { display: grid; grid-template-columns: 1.25fr .75fr; gap: 3rem; align-items: start; }
  .quote-card { position: sticky; top: 8.5rem; }
  @media (max-width: 900px) {
    .hero-layout, .split { grid-template-columns: 1fr; gap: 2.5rem; }
    .quote-card { position: static; }
  }
</style>
