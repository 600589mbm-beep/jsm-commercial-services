---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { BUSINESS, url } from '../config';
---

<Base
  title={`About Us | ${BUSINESS.name}`}
  description={`${BUSINESS.name} has provided commercial cleaning and janitorial services across the ${BUSINESS.serviceArea} since ${BUSINESS.foundingYear}.`}
>
  <section class="section">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Home</a> / About</nav>
      <div class="section-head">
        <h1>About {BUSINESS.name}</h1>
      </div>
      <div class="prose">
        <p>
          {BUSINESS.name} was founded in {BUSINESS.foundingYear} on a simple observation: most
          commercial cleaning companies are easy to hire and hard to keep happy with. Crews rotate,
          quality drifts, and problems take a week of phone calls to fix.
        </p>
        <p>
          We built our company around fixing that. Every account gets a documented scope of work,
          a consistent assigned crew, scheduled supervisor inspections, and one phone number that
          gets a same-day answer. That's why {BUSINESS.stats.facilitiesServed} facilities across
          the {BUSINESS.serviceArea} trust us with their buildings — and why our average client
          has been with us for years, on month-to-month agreements.
        </p>
        <h2>Our Promise</h2>
        <ul class="checklist">
          <li>Trained, uniformed, background-checked cleaners on every account</li>
          <li>Full general liability and workers' compensation coverage</li>
          <li>Documented checklists and supervisor quality inspections</li>
          <li>Same-day response to any service issue</li>
          <li>No long-term contracts — we earn your business monthly</li>
        </ul>
      </div>
    </div>
  </section>
  <CTA />
</Base>

<style>
  .prose { max-width: 760px; }
</style>
