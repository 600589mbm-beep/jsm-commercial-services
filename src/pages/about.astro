---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { BUSINESS, url } from '../config';
import { LOCATIONS } from '../data/locations';
import { SERVICES } from '../data/services';
---

<Base
  title={`About ${BUSINESS.name} — Apple Valley, MN | Commercial Cleaning`}
  description={`${BUSINESS.name} is an owner-led commercial cleaning company based in Apple Valley, MN, serving ${LOCATIONS.length} Twin Cities communities with documented scopes and accountable local service.`}
>
  <section class="about-hero">
    <div class="container">
      <nav class="crumbs"><a href={url('/')}>Home</a> / About</nav>
      <p class="eyebrow">Owner-led commercial cleaning</p>
      <h1>Enterprise standards should not require layers of corporate distance</h1>
      <p class="lead">JSM was built to give Twin Cities facility teams a structured cleaning program and direct access to the people responsible for delivering it.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="prose">
        <p>
          <strong>{BUSINESS.name} is a commercial cleaning and janitorial company based in Apple Valley, Minnesota</strong>,
          serving {LOCATIONS.length} communities across the {BUSINESS.serviceArea} with {SERVICES.length} service lines—from
          recurring janitorial and day porter coverage to floor care, medical-office cleaning, post-construction cleaning, and snow removal.
        </p>
        <h2>Why JSM exists</h2>
        <p>
          Commercial cleaning often breaks down after the sale. Crews rotate, tasks become unclear,
          inspections disappear, and simple concerns take too many emails to correct. JSM is organized
          around preventing that drift with a written scope, an assigned team, supervisor inspections,
          and one accountable local contact.
        </p>
        <h2>What clients can expect</h2>
        <ul class="checklist">
          <li>Facility-specific scope of work and cleaning schedule</li>
          <li>Background-checked, trained, and uniformed crew members</li>
          <li>General liability and workers’ compensation coverage</li>
          <li>Certificate of insurance and additional-insured documentation on request</li>
          <li>Supervisor quality inspections and direct issue escalation</li>
          <li>Free re-clean guarantee when a visit misses the written scope</li>
          <li>Month-to-month agreements that keep accountability active</li>
        </ul>
      </div>
      <aside class="accountability-card">
        <p class="eyebrow">Owner-led accountability</p>
        <h2>The responsibility stays close to the work</h2>
        <p>
          Every proposal, service plan, and unresolved concern ultimately reaches local ownership.
          The phone number on this site is not a national call queue; it is a direct path to the team
          accountable for your facility.
        </p>
        <a class="btn btn-primary" href={url('/facility-care-program')}>See How the Program Works</a>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="container service-area">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2>Local coverage across the Twin Cities metro</h2>
        <p>
          JSM is headquartered at {BUSINESS.address.street}, {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip},
          serving the metro from {LOCATIONS[0].name} to Stillwater.
        </p>
        <a class="btn btn-navy" href={url('/locations')}>See All {LOCATIONS.length} Service Areas</a>
      </div>
      <iframe
        class="map"
        src={`https://www.google.com/maps?q=${encodeURIComponent(`${BUSINESS.address.city}, ${BUSINESS.address.state}`)}&z=10&output=embed`}
        width="100%"
        height="340"
        style="border:0; border-radius: 14px;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Service area map centered on ${BUSINESS.address.city}, MN`}
      ></iframe>
    </div>
  </section>

  <CTA heading="Work with a cleaning partner that stays accountable" />
</Base>

<style>
  .about-hero { background: linear-gradient(145deg, var(--navy-dark), var(--navy)); color: #fff; padding: 4.5rem 0; }
  .about-hero .crumbs, .about-hero .crumbs a { color: #c8d7e3; }
  .eyebrow { color: var(--teal-dark); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .about-hero .eyebrow { color: var(--teal-bright); }
  .about-hero h1 { color: #fff; max-width: 900px; }
  .lead { color: #c8d7e3; font-size: 1.12rem; max-width: 760px; }
  .about-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 4rem; align-items: start; }
  .prose h2 { margin-top: 2rem; }
  .accountability-card { position: sticky; top: 8rem; background: linear-gradient(155deg, var(--navy), var(--navy-dark)); color: #fff; border-radius: 18px; padding: 2rem; box-shadow: var(--shadow-lift); }
  .accountability-card .eyebrow { color: var(--teal-bright); }
  .accountability-card h2 { color: #fff; }
  .accountability-card p { color: #c8d7e3; }
  .service-area { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; align-items: center; }
  @media (max-width: 850px) {
    .about-grid, .service-area { grid-template-columns: 1fr; }
    .accountability-card { position: static; }
  }
</style>
