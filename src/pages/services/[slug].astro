---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../config';
import { SERVICES } from '../../data/services';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.short,
  areaServed: BUSINESS.serviceArea,
  provider: {
    '@type': 'LocalBusiness',
    name: BUSINESS.name,
    telephone: BUSINESS.phone,
  },
};

const faqSchema =
  service.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Base
  title={`${service.name} — Twin Cities & Apple Valley, MN | ${BUSINESS.name}`}
  description={`${service.short} ${BUSINESS.name} serves the ${BUSINESS.serviceArea}. Free quotes within 24 hours.`}
>
  <section class="section">
    <div class="container split">
      <div>
        <nav class="crumbs">
          <a href={url('/')}>Home</a> / <a href={url('/services')}>Services</a> / {service.name}
        </nav>
        <h1>{service.name}</h1>
        <p>{service.description}</p>
        <h2>What's Included</h2>
        <ul class="checklist">
          {service.bullets.map((b) => <li>{b}</li>)}
        </ul>
        {service.faq.length > 0 && (
          <>
            <h2>Frequently Asked Questions</h2>
            {service.faq.map((f) => (
              <details class="faq-acc">
                <summary>{f.q}<span class="plus">+</span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </>
        )}
      </div>
      <aside class="card">
        <h2>Get a Free Quote</h2>
        <p>Tell us about your facility. {BUSINESS.responsePromise}</p>
        <QuoteForm />
      </aside>
    </div>
  </section>
  <CTA heading={`Need ${service.name.toLowerCase()}?`} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
