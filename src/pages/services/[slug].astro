---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { BUSINESS, url } from '../../config';
import { SERVICES } from '../../data/services';
import { LOCATIONS } from '../../data/locations';
import { breadcrumbList } from '../../lib/breadcrumbs';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const isJanitorial = service.slug === 'janitorial-services';
const canonical = new URL(`/services/${service.slug}/`, BUSINESS.website).href;
const businessId = `${new URL('/', BUSINESS.website).href}#localbusiness`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: service.name,
  ...(service.aliases?.length ? { alternateName: service.aliases, serviceType: service.aliases } : { serviceType: service.name }),
  description: service.short,
  url: canonical,
  areaServed: { '@type': 'AdministrativeArea', name: BUSINESS.serviceArea },
  provider: { '@id': businessId },
};

const faqSchema = service.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: service.faq.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }
  : null;

const breadcrumbSchema = breadcrumbList(BUSINESS.website, [
  ['Home', '/'],
  ['Services', '/services'],
  [service.name, null],
]);

const title = isJanitorial
  ? `Commercial Janitorial Services | Twin Cities, MN | ${BUSINESS.shortName}`
  : `${service.name} | Twin Cities, MN | ${BUSINESS.shortName}`;
const description = isJanitorial
  ? 'Recurring commercial janitorial and nightly cleaning across the Twin Cities with written scopes, background-checked crews, supervisor inspections, and month-to-month agreements.'
  : `${service.name} for Twin Cities commercial facilities. Written scopes, trained crews, supervisor inspections, and free facility walkthroughs from ${BUSINESS.shortName}.`;
---

<Base title={title} description={description}>
  <section class="service-hero">
    <div class="container hero-layout">
      <div>
        <nav class="crumbs dark">
          <a href={url('/')}>Home</a> / <a href={url('/services')}>Services</a> / {service.name}
        </nav>
        <p class="eyebrow">Twin Cities commercial facility service</p>
        <h1>{isJanitorial ? 'Commercial Janitorial Services' : service.name}</h1>
        <p class="lead">
          <strong>{BUSINESS.name}</strong> provides {service.name.toLowerCase()} for commercial facilities
          throughout the {BUSINESS.serviceArea}, supported by a written scope, trained team, supervisor
          quality checks, and direct local accountability.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={url('/quote')}>Request a Free Facility Walkthrough</a>
          <a class="btn btn-outline" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
        </div>
      </div>
      <aside class="service-summary">
        <p class="card-label">Service overview</p>
        <p>{service.short}</p>
        <ul>
          <li>Facility-specific written scope</li>
          <li>Schedule built around operations</li>
          <li>Supervisor quality inspections</li>
          <li>Free re-clean guarantee</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p>{service.description}</p>
        {service.aliases?.length && (
          <p class="service-terms">
            <strong>Related service names:</strong> {service.aliases.join(' · ')}
          </p>
        )}
        <h2>What’s Included</h2>
        <ul class="checklist">
          {service.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>

        {isJanitorial && (
          <section class="contract-callout">
            <p class="eyebrow navy">Need a recurring agreement?</p>
            <h2>Build a measurable janitorial contract</h2>
            <p>
              JSM’s janitorial-contract process documents rooms, tasks, service frequencies, supplies,
              inspections, pricing, startup, and cancellation terms so every vendor and facility contact
              is working from the same expectations.
            </p>
            <a class="btn btn-navy" href={url('/janitorial-contracts')}>Explore Janitorial Contracts</a>
          </section>
        )}

        {service.faq.length > 0 && (
          <>
            <h2>Frequently Asked Questions</h2>
            {service.faq.map((faq) => (
              <details class="faq-acc">
                <summary>{faq.q}<span class="plus">+</span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </>
        )}

        <details class="faq-acc">
          <summary>{service.name} across the metro — view all {LOCATIONS.length} cities<span class="plus">+</span></summary>
          <p class="link-cloud">
            {LOCATIONS.map((location) => (
              <a href={url(`/locations/${location.slug}/${service.slug}`)}>{location.name}</a>
            ))}
          </p>
        </details>
      </div>
      <aside class="card quote-card">
        <h2>{service.slug === 'snow-removal' ? 'Get a Free Snow Quote' : 'Request a Free Walkthrough'}</h2>
        <p>{service.slug === 'snow-removal' ? 'Tell us about your property.' : 'Tell us about your facility.'} {BUSINESS.responsePromise}</p>
        <QuoteForm variant={service.slug === 'snow-removal' ? 'snow' : 'cleaning'} />
      </aside>
    </div>
  </section>

  <CTA heading={`Need more accountable ${service.name.toLowerCase()}?`} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .service-hero { padding: 4.8rem 0; color: #fff; background: linear-gradient(145deg, #071a2a, var(--navy) 65%, #174654); }
  .hero-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: 4rem; align-items: center; }
  .crumbs.dark, .crumbs.dark a { color: #c5d5e0; }
  .eyebrow { color: var(--teal-bright); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .eyebrow.navy { color: var(--teal-dark); }
  h1 { color: #fff; font-size: clamp(2.45rem, 5vw, 4rem); }
  .lead { color: #c8d7e3; font-size: 1.08rem; max-width: 740px; }
  .lead strong { color: #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.7rem; }
  .service-summary { padding: 1.8rem; border: 1px solid rgba(255,255,255,.16); border-radius: 18px; background: rgba(255,255,255,.09); }
  .card-label { color: var(--teal-bright); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .service-summary p:not(.card-label) { color: #d8e5ec; }
  .service-summary ul { list-style: none; padding: 0; margin: 0; }
  .service-summary li { position: relative; padding: .65rem 0 .65rem 1.55rem; border-bottom: 1px solid rgba(255,255,255,.12); }
  .service-summary li::before { content: '✓'; position: absolute; left: 0; color: var(--teal-bright); font-weight: 800; }
  .split { display: grid; grid-template-columns: 1.25fr .75fr; gap: 3rem; align-items: start; }
  .quote-card { position: sticky; top: 8.5rem; }
  .service-terms { padding: .8rem 1rem; border-left: 3px solid var(--teal); background: var(--bg-alt); color: var(--text-soft); font-size: .86rem; }
  .service-terms strong { color: var(--navy); }
  .contract-callout { margin: 2rem 0; padding: 1.6rem; border-left: 4px solid var(--teal); border-radius: 0 12px 12px 0; background: var(--bg-alt); }
  .link-cloud { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: .95rem; }
  .link-cloud a { text-decoration: none; font-weight: 600; }
  .link-cloud a:hover { text-decoration: underline; }
  @media (max-width: 900px) {
    .hero-layout, .split { grid-template-columns: 1fr; gap: 2.5rem; }
    .quote-card { position: static; }
  }
</style>
