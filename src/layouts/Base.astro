---
import { ClientRouter } from 'astro:transitions';
import { BUSINESS, url } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCall from '../components/StickyCall.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const {
  title,
  description,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, BUSINESS.website);
const homepage = new URL('/', BUSINESS.website).href;
const ogImage = new URL(url('/og-default.png').replace(/\/$/, ''), BUSINESS.website).href;
const businessId = `${homepage}#localbusiness`;
const websiteId = `${homepage}#website`;
const webpageId = `${canonical.href}#webpage`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': businessId,
      name: BUSINESS.name,
      alternateName: BUSINESS.shortName,
      legalName: BUSINESS.legalName,
      url: homepage,
      image: ogImage,
      logo: ogImage,
      telephone: BUSINESS.phoneE164,
      email: BUSINESS.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: BUSINESS.address.street,
        addressLocality: BUSINESS.address.city,
        addressRegion: BUSINESS.address.state,
        postalCode: BUSINESS.address.zip,
        addressCountry: 'US',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '17:00',
      },
      areaServed: [
        { '@type': 'City', name: 'Apple Valley, Minnesota' },
        { '@type': 'AdministrativeArea', name: BUSINESS.serviceArea },
      ],
      foundingDate: String(BUSINESS.foundingYear),
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: BUSINESS.phoneE164,
          contactType: 'sales',
          email: BUSINESS.email,
          areaServed: 'US-MN',
          availableLanguage: 'English',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homepage,
      name: BUSINESS.name,
      alternateName: BUSINESS.shortName,
      publisher: { '@id': businessId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': businessId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630,
      },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="author" content={BUSINESS.legalName} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href={url('/sitemap-index.xml').replace(/\/$/, '')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BUSINESS.name} commercial cleaning and janitorial services`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={url('/fonts/manrope-latin.woff2').replace(/\/$/, '')}
    />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg').replace(/\/$/, '')} />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Cookieless self-hosted analytics beacon (no third-party, no PII stored). -->
    <script>
      function jsmTrack() {
        try {
          new Image().src = 'https://191-101-2-203.sslip.io/track?s=' +
            encodeURIComponent(location.hostname) + '&p=' +
            encodeURIComponent(location.pathname) + '&r=' +
            encodeURIComponent(document.referrer ? new URL(document.referrer).hostname : '') +
            '&t=' + Date.now();
        } catch (e) {}
      }
      jsmTrack();
      document.addEventListener('astro:page-load', jsmTrack);
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCall />
    <button class="to-top" aria-label="Back to top">↑</button>
    <script>
      // Re-runs after every ClientRouter page swap as well as the initial load.
      function initPage() {
        const revealables = document.querySelectorAll(
          '.card, .section-head, .faq-item, .faq-acc, blockquote, .trust-bar, .step-card'
        );
        const groups = new Map<Element | null, number>();
        revealables.forEach((el) => {
          const parent = el.parentElement;
          const i = groups.get(parent) ?? 0;
          groups.set(parent, i + 1);
          (el as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i, 5) * 80}ms`);
          el.classList.add('reveal');
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealables.forEach((el) => io.observe(el));
        onScroll();
      }

      const onScroll = () => {
        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        document.body.classList.toggle('scrolled', scrollY > 8);
        document.querySelector('.to-top')?.classList.toggle('show', scrollY > 600);
      };
      addEventListener('scroll', onScroll, { passive: true });

      if (matchMedia('(pointer: fine)').matches) {
        addEventListener('pointermove', (e) => {
          const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { passive: true });
      }

      addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.to-top')) {
          scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
