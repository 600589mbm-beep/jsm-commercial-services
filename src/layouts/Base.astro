---
import { ClientRouter } from 'astro:transitions';
import { BUSINESS, url } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCall from '../components/StickyCall.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: BUSINESS.name,
  legalName: BUSINESS.legalName,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    postalCode: BUSINESS.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  areaServed: BUSINESS.serviceArea,
  foundingDate: String(BUSINESS.foundingYear),
  url: canonical.href,
  // aggregateRating intentionally omitted until real review data exists —
  // fabricated structured-data ratings risk both trust and search penalties.
  ...(BUSINESS.showStats && BUSINESS.stats.rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: BUSINESS.stats.rating,
          reviewCount: BUSINESS.stats.reviewCount,
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href={url('/sitemap-index.xml').replace(/\/$/, '')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={url('/fonts/manrope-latin.woff2').replace(/\/$/, '')}
    />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg').replace(/\/$/, '')} />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCall />
    <button class="to-top" aria-label="Back to top">↑</button>
    <script>
      // Re-runs after every ClientRouter page swap as well as the initial load.
      function initPage() {
        // Scroll-reveal: stagger cards and section heads as they enter the viewport.
        const revealables = document.querySelectorAll(
          '.card, .section-head, .faq-item, .faq-acc, blockquote, .trust-bar, .step-card'
        );
        const groups = new Map<Element | null, number>();
        revealables.forEach((el) => {
          const parent = el.parentElement;
          const i = groups.get(parent) ?? 0;
          groups.set(parent, i + 1);
          (el as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i, 5) * 80}ms`);
          el.classList.add('reveal');
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealables.forEach((el) => io.observe(el));
        onScroll();
      }

      // Scroll progress bar + header shadow + back-to-top visibility
      const onScroll = () => {
        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        document.body.classList.toggle('scrolled', scrollY > 8);
        document.querySelector('.to-top')?.classList.toggle('show', scrollY > 600);
      };
      addEventListener('scroll', onScroll, { passive: true });

      // Cursor-tracking glow on cards (event delegation, desktop pointers only)
      if (matchMedia('(pointer: fine)').matches) {
        addEventListener('pointermove', (e) => {
          const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { passive: true });
      }

      addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.to-top')) {
          scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
